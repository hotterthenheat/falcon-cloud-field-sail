+  const card = useNameCard(asked ? symbol : null);
+  /* the quote this browser already holds paints at once; the store is asked only after the rest */
+  const held = peekQuote(symbol);
+  const spot = held?.regularPrice ?? null;
+  return (
+    <div className="flex flex-col gap-1.5" data-name-card={symbol} data-name-card-status={card?.status ?? 'waiting'}>
+      <div className="flex items-center gap-2.5">
+        <CompanyLogo ticker={symbol} size={compact ? 22 : 28} />
+        <div className="min-w-0 leading-tight flex-1">
+          <div className="font-mono text-t14 font-bold text-textPrimary">{symbol}</div>
+          <div className="text-t11 text-textSecondary truncate">{name && name.toUpperCase() !== symbol ? name : ' '}</div>
+        </div>
+        {compact && <div className="shrink-0 text-right">{asked ? <LivePrice symbol={symbol} /> : <PriceLine q={held} />}</div>}
+      </div>
+      {!compact && (asked ? <LivePrice symbol={symbol} /> : <PriceLine q={held} />)}
+
+      {!compact && (
+        <section>
+          <Head icon={Layers} ink={CALL_WALL}>The walls</Head>
+          <Walls symbol={symbol} spot={spot} />
+        </section>
+      )}
+
+      {!compact && (
+        <section>
+          <Head icon={Compass} ink="rgb(var(--silver))">Compass</Head>
+          <CompassCall symbol={symbol} />
+        </section>
+      )}
+
+      <section>
+        <Head icon={CalendarDays} ink="rgb(var(--moon))">Earnings · next report</Head>
+        <Slow card={card} table="earnings" floor={FLOOR.report} kind="report" lines={1} pairs={2}>
+          <ReportSlot symbol={symbol} />
+        </Slow>
+      </section>
+
+      <section>
+        <Head icon={Newspaper} ink="rgb(var(--glacier))">News · today</Head>
+        <Slow card={card} table="news" floor={FLOOR.wire} kind="wire" lines={compact ? 2 : 4}>
+          <WireSlot symbol={symbol} compact={compact} />
+        </Slow>
+      </section>
+
+      {!compact && (
+        <section>
+          <Head icon={Users} ink={CALL_WALL}>Insiders · 90 days</Head>
+          <Slow card={card} table="insiders" floor={FLOOR.hands} kind="insiders" lines={0} pairs={2}>
+            <InsidersSlot symbol={symbol} />
+          </Slow>
+          <div className="mt-1.5">
+            <Head icon={Landmark} ink={PUT_WALL}>Congress · 180 days</Head>
+          </div>
+          <Slow card={card} table="congress" floor={FLOOR.congress} kind="congress" lines={1}>
+            <CongressSlot symbol={symbol} />
+          </Slow>
+        </section>
+      )}
+    </div>
+  );
+};
+
+export default NameHoverCard;
