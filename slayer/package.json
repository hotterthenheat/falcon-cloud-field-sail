    "ag-grid-react": "^36.1.0",
    "codemirror": "^6.0.2",
    "d3-geo": "^2.0.2",
    "express": "^5.2.1",
    "framer-motion": "^12.43.0",
    "html2canvas": "^1.4.1",
    "lightweight-charts": "^5.2.0",
