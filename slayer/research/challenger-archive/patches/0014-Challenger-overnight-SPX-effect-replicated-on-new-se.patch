+"""Overnight quote check, SPXW against XSP (the same index at a tenth): how often each minute's NBBO changes, and how
+far SPXW's put-call parity forward sits from 10 x XSP's, minute by minute, over the overnight session.
+
+  python -I research/challenger/stale_check.py 20260929 20261001 ...
+"""
+import gzip, os, sys
+import numpy as np
+import pandas as pd
+
+DATA = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'data')
+
+
+def chain(day, root):
+    f = os.path.join(DATA, 'raw', day, f'{root}_{day}.csv.gz')
+    df = pd.read_csv(gzip.open(f), header=None, names=['k', 'strike', 'right', 'bid', 'ask', 'bs', 'as'])
+    df['hm'] = df.k.str[11:16]
+    return df[(df.hm >= '20:15') | (df.hm < '09:20')]
+
+
+def forward(g):
+    p = g.pivot_table(index='strike', columns='right', values='mid')
+    p = p.dropna()
+    if p.empty:
+        return np.nan
+    p['gap'] = (p['C'] - p['P']).abs()
+    best = p.sort_values('gap').head(3)
+    return float(np.median(best.index + best['C'] - best['P']))
+
+
+for day in sys.argv[1:]:
+    out = {}
+    for root in ('SPXW', 'XSP'):
+        df = chain(day, root)
+        df['mid'] = (df.bid + df.ask) / 2
+        df = df.sort_values(['strike', 'right', 'k'])
+        same = (df.groupby(['strike', 'right'])[['bid', 'ask']].diff().abs().sum(axis=1) == 0)
+        fw = df.groupby('k').apply(forward, include_groups=False)
+        out[root] = (same.mean(), fw)
+    f1, f2 = out['SPXW'][1], out['XSP'][1] * 10
+    j = pd.concat([f1, f2], axis=1, keys=['spxw', 'xsp10']).dropna()
+    j['diff_bp'] = (j.spxw / j.xsp10 - 1) * 1e4
+    # does SPXW lag XSP? correlation of SPXW's 5-minute change with XSP's change 5 minutes earlier
+    ch = j[['spxw', 'xsp10']].pct_change(5)
+    lag = ch['spxw'].corr(ch['xsp10'].shift(5))
+    co = ch['spxw'].corr(ch['xsp10'])
+    print(f"{day}: unchanged minute-to-minute: SPXW {100 * out['SPXW'][0]:.0f}%, XSP {100 * out['XSP'][0]:.0f}%; "
+          f"forward SPXW vs 10xXSP median {j.diff_bp.median():+.1f} bp (p5 {j.diff_bp.quantile(.05):+.1f}, p95 {j.diff_bp.quantile(.95):+.1f}); "
+          f"5-min change corr same-time {co:.2f}, SPXW vs XSP 5 min earlier {lag:.2f}")
