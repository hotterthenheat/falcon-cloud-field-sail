+"""At the minute an overnight SPXW candidate's bid first reached 1.50x its fill, was that bid in line with the same
+option on XSP (strike / 10, x 10)? An outlier bid that XSP does not show would be a quote artefact, not a move.
+
+  python -I research/challenger/tp_check.py
+"""
+import gzip, os, sys
+import numpy as np
+import pandas as pd
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import books as B
+
+DATA = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'data')
+days = [d for d in B.dev_days() if d >= '2026-08']
+S = B.Sessions(days)
+d = S.df
+x = d[(d.session == 'overnight') & (d.ticker == 'SPXW') & (d.c14 >= .1) & (d.c14 <= .4) & (d.sleeve == 'odte') & (d.hit50 == 1) & ((d.strike % 10) == 0)]
+x = x.sample(min(400, len(x)), random_state=1)
+cache = {}
+
+
+def chain(day, root, exp):
+    k = (day, root, exp)
+    if k not in cache:
+        f = os.path.join(DATA, 'raw', day.replace('-', ''), f'{root}_{exp.replace("-", "")}.csv.gz')
+        if not os.path.exists(f):
+            cache[k] = None
+        else:
+            df = pd.read_csv(gzip.open(f), header=None, names=['k', 'strike', 'right', 'bid', 'ask', 'bs', 'as'])
+            cache[k] = df.set_index(['k', 'strike', 'right'])
+    return cache[k]
+
+
+rows = []
+for _, r in x.iterrows():
+    sp = chain(r.day, 'SPXW', r.expiry)
+    xs = chain(r.day, 'XSP', r.expiry)
+    if sp is None or xs is None:
+        continue
+    # the hit minute: the mark + the fill offset + the minutes to +50%, as a NY wall key
+    mk = pd.Timestamp(f'{r.day} {r.mark}') - (pd.Timedelta(days=1) if r.mark >= '20:15' else pd.Timedelta(0))
+    hit = mk + pd.Timedelta(minutes=1 + float(r.min50))
+    key = hit.strftime('%Y-%m-%d %H:%M')
+    try:
+        s = sp.loc[(key, r.strike, r.right)]
+        q = xs.loc[(key, r.strike / 10, r.right)]
+    except KeyError:
+        continue
+    rows.append({'spx_bid': s.bid, 'spx_ask': s.ask, 'spx_bs': s.bs, 'xsp_bid10': q.bid * 10, 'xsp_mid10': (q.bid + q.ask) * 5, 'xsp_ask10': q.ask * 10, 'fill': r.fill})
+t = pd.DataFrame(rows)
+t['bid_vs_xsp_mid'] = t.spx_bid / t.xsp_mid10 - 1
+t['xsp_bid_vs_fill'] = t.xsp_bid10 / t.fill
+print(f'{len(t)} SPXW overnight +50% moments matched to XSP at the same minute')
+print('SPXW bid / (10 x XSP mid) - 1: median %+.2f%%, p10 %+.2f%%, p90 %+.2f%%' % tuple(100 * t.bid_vs_xsp_mid.quantile([.5, .1, .9])))
+print('share where 10 x XSP bid also >= 1.50 x the SPXW fill: %.0f%%' % (100 * (t.xsp_bid_vs_fill >= 1.5).mean()))
+print('share where 10 x XSP bid >= 1.40 x the SPXW fill: %.0f%%' % (100 * (t.xsp_bid_vs_fill >= 1.4).mean()))
+print('SPXW bid size at the moment: median %d, share of 1-lot bids %.0f%%' % (t.spx_bs.median(), 100 * (t.spx_bs <= 1).mean()))
