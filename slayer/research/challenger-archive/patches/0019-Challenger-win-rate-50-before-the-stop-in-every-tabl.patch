@@ -0,0 +1,148 @@
+"""Overfitting checks, written here from the papers (Bailey, Borwein, López de Prado & Zhu, "The Probability of
+Backtest Overfitting", 2015; Bailey & López de Prado, "The Deflated Sharpe Ratio", 2014). Nothing vendored.
+
+- PBO by combinatorially symmetric cross-validation (CSCV): the development sessions, in time order, are cut into S
+  equal blocks; for every way of choosing S/2 blocks as in-sample (the rest out-of-sample), the configuration of a
+  family that is best in-sample is ranked among the family out-of-sample; omega = rank / (N + 1), lambda =
+  logit(omega); PBO = the share of splits where lambda <= 0 (the in-sample winner is at or below the out-of-sample
+  median).
+- Deflated Sharpe ratio of a candidate's per-call returns: the probability that its true Sharpe exceeds the
+  expected maximum Sharpe of N independent trials with the trials' Sharpe variance, corrected for the returns' skew
+  and kurtosis and the sample length.
+
+  python -I research/challenger/overfit.py            (the overnight family and the Hit-score filter family)
+"""
+import itertools, math, os, sys
+import numpy as np
+from statistics import NormalDist
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import common as C
+import books as B
+
+N01 = NormalDist()
+EULER = 0.5772156649015329
+
+
+def per_session_stats(S, idx, exit_rule):
+    """Per session: calls, wins (+50% before the stop), sum of returns."""
+    per = S.per_session(idx, exit_rule)
+    days = S.days
+    calls = np.array([len(per[d]) for d in days], float)
+    wins = np.array([sum(1 for x in per[d] if x[3]) for d in days], float)
+    rets = np.array([sum(x[0] for x in per[d]) for d in days], float)
+    allr = np.array([x[0] for d in days for x in per[d]], float)
+    return calls, wins, rets, allr
+
+
+def pbo(mats, metric='win', blocks=16, min_calls=5):
+    """mats: list of (calls, wins, rets) per configuration, each an array over sessions in time order.
+    metric 'win' (pooled win rate) or 'ret' (pooled mean return per call). Returns (pbo, n_splits, lambdas)."""
+    T = len(mats[0][0])
+    N = len(mats)
+    edges = np.linspace(0, T, blocks + 1).astype(int)
+    blk = [np.arange(edges[i], edges[i + 1]) for i in range(blocks)]
+    def perf(sel):
+        out = np.full(N, -np.inf)
+        for j, (c, w, r) in enumerate(mats):
+            n = c[sel].sum()
+            if n >= min_calls:
+                out[j] = (w[sel].sum() if metric == 'win' else r[sel].sum()) / n
+        return out
+    lams = []
+    for combo in itertools.combinations(range(blocks), blocks // 2):
+        ins = np.concatenate([blk[i] for i in combo])
+        oos = np.concatenate([blk[i] for i in range(blocks) if i not in combo])
+        pi, po = perf(ins), perf(oos)
+        if not np.isfinite(pi).any():
+            continue
+        best = int(np.argmax(pi))
+        valid = np.isfinite(po)
+        if not valid[best] or valid.sum() < 2:
+            continue
+        # rank of the in-sample winner among the out-of-sample performances (1 = worst)
+        rank = 1 + np.sum(po[valid] < po[best]) + 0.5 * (np.sum(po[valid] == po[best]) - 1)
+        omega = rank / (valid.sum() + 1)
+        lams.append(math.log(omega / (1 - omega)))
+    lams = np.array(lams)
+    return float(np.mean(lams <= 0)) if len(lams) else np.nan, len(lams), lams
+
+
+def deflated_sharpe(returns, n_trials, sr_var):
+    """DSR of per-call returns given the number of trials and the variance of the trials' Sharpe ratios."""
+    r = np.asarray(returns, float)
+    T = len(r)
+    if T < 3 or r.std(ddof=1) == 0:
+        return np.nan, np.nan, np.nan
+    sr = r.mean() / r.std(ddof=1)
+    z = (r - r.mean()) / r.std(ddof=0)
+    skew = float(np.mean(z ** 3))
+    kurt = float(np.mean(z ** 4))
+    n = max(2, int(n_trials))
+    sr0 = math.sqrt(max(sr_var, 0.0)) * ((1 - EULER) * N01.inv_cdf(1 - 1 / n) + EULER * N01.inv_cdf(1 - 1 / (n * math.e)))
+    den = math.sqrt(max(1e-12, 1 - skew * sr + (kurt - 1) / 4 * sr * sr))
+    dsr = N01.cdf((sr - sr0) * math.sqrt(T - 1) / den)
+    return dsr, sr, sr0
+
+
+def overnight_family(S):
+    """The overnight SPXW rule's grid: |delta| band x entry window (minutes since 20:15) x side."""
+    d = S.df
+    out = []
+    bands = [(0.10, 0.20), (0.10, 0.25), (0.15, 0.25), (0.15, 0.30), (0.20, 0.35), (0.10, 0.30)]
+    windows = [(225, 464, '00:00-03:59'), (120, 700, '22:15-07:55'), (225, 700, '00:00-07:55'), (345, 585, '02:00-05:59'), (0, 224, '20:15-23:59')]
+    sides = [('gap', 1), ('against', -1)]
+    base = (d['session'].values == 'overnight') & (d['ticker'].values == 'SPXW')
+    for (lo, hi), (w0, w1, wl), (sl, sg) in itertools.product(bands, windows, sides):
+        el = base & (d['c14'].values >= lo) & (d['c14'].values <= hi) & (d['c1'].values >= w0) & (d['c1'].values <= w1) & (sg * d['c33'].values > 0)
+        score = np.where(el, 1.0 - np.abs(d['c14'].values - (lo + hi) / 2), np.nan)
+        out.append((f'SPXW overnight |delta| {lo:.2f}-{hi:.2f}, {wl}, {sl} side', score, 'tp'))
+    return out
+
+
+def hit_family(S):
+    d = S.df
+    p1 = d['p1'].values.astype(float)
+    f = np.isfinite
+    fl = {'none': np.ones(len(d), bool), 'gap with': f(d.c33.values) & (d.c33.values > 0.0009), 'spread<=1.6%': f(d.c11.values) & (d.c11.values <= 0.0159),
+          'rv/iv<=0.7': f(d.c26.values) & (d.c26.values <= 0.7), 'delta 0.3-0.7': f(d.c14.values) & (d.c14.values >= 0.3) & (d.c14.values <= 0.7),
+          'prem>=0.3EM': f(d.c18.values) & (d.c18.values >= 0.3), 'shock>=1': f(d.c49.values) & (d.c49.values >= 1), '0DTE': d.dte.values == 0, '1-7DTE': d.dte.values >= 1}
+    out = []
+    for k, m in fl.items():
+        for ex in ('prun', 'ride'):
+            out.append((f'Hit score, {k}, {ex}', np.where(m, p1, np.nan), ex))
+    return out
+
+
+def run_family(S, fam, line, title, n_trials):
+    mats, srs, best = [], [], None
+    rows = []
+    for name, score, ex in fam:
+        idx = S.calls(score, line)
+        c, w, r, allr = per_session_stats(S, idx, ex)
+        mats.append((c, w, r))
+        if len(allr) >= 5 and allr.std(ddof=1) > 0:
+            srs.append(allr.mean() / allr.std(ddof=1))
+        n = c.sum()
+        rows.append((name, int(n), w.sum() / n if n else np.nan, r.sum() / n if n else np.nan, allr))
+    p_win, ns, _ = pbo(mats, 'win')
+    p_ret, _, _ = pbo(mats, 'ret')
+    print(f'\n## {title}: {len(fam)} configurations, {len(S.days)} development sessions, CSCV 16 blocks ({ns} splits)')
+    print(f'PBO (win rate) {p_win:.2f}; PBO (return per call) {p_ret:.2f}')
+    rows.sort(key=lambda x: -(x[2] if np.isfinite(x[2]) else -1))
+    sr_var = float(np.var(srs, ddof=1)) if len(srs) > 1 else 0.0
+    print('| configuration | calls | win | return/call | DSR (N = %d trials) |' % n_trials)
+    print('|---|---:|---:|---:|---:|')
+    for name, n, wr, rr, allr in rows[:8]:
+        dsr, sr, sr0 = deflated_sharpe(allr, n_trials, sr_var)
+        print(f'| {name} | {n} | {100 * wr:.0f}% | {100 * rr:+.1f}% | {dsr:.2f} (SR {sr:.2f} vs {sr0:.2f}) |')
+    return p_win, p_ret, rows
+
+
+if __name__ == '__main__':
+    trials = int(os.environ.get('TRIALS', '0') or 0)
+    S = B.Sessions(B.dev_days())
+    fam_on = overnight_family(S)
+    fam_hit = hit_family(S)
+    n = trials or (23 + len(fam_on) + len(fam_hit))
+    run_family(S, fam_on, 0.0, 'Overnight SPXW rule family', n)
+    run_family(S, fam_hit, C.P1_MIN, 'Hit-score filter family', n)
