diff --git a/slayer/research/challenger/integrity.py b/slayer/research/challenger/integrity.py
new file mode 100644
index 0000000..e3c8265
--- /dev/null
+++ b/slayer/research/challenger/integrity.py
@@ -0,0 +1,73 @@
+"""After the disk filled: every cache file must parse. A broken raw file is deleted with its day's _done.json (the
+fetcher reads the day again); a broken built file is deleted with the rest of its day (the builders build it
+again); a broken 1-second or sweep cache is deleted (read again from the terminal).
+
+  python3 research/challenger/integrity.py [--fix]
+"""
+import glob, gzip, json, os, sys
+
+D = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'data')
+fix = '--fix' in sys.argv
+bad = []
+
+
+def ok_gz(f):
+    try:
+        with gzip.open(f, 'rb') as g:
+            while g.read(1 << 20):
+                pass
+        return True
+    except Exception:
+        return False
+
+
+def ok_json(f):
+    try:
+        json.load(open(f))
+        return True
+    except Exception:
+        return False
+
+
+def ok_parquet(f):
+    try:
+        import pyarrow.parquet as pq
+        pq.read_metadata(f)
+        return True
+    except Exception:
+        return False
+
+
+checks = [('raw/*/*.csv.gz', ok_gz, 'raw'), ('raw/*/*.sweep.json', ok_json, 'cache'), ('raw/*/_done.json', ok_json, 'raw'),
+          ('bars/*/*.csv.gz', ok_gz, 'bars'), ('rows/*.csv.gz', ok_gz, 'rows'), ('rows/*.parquet', ok_parquet, 'rows'),
+          ('rows/*.calls.json', ok_json, 'rows'), ('cache1s/*.json', ok_json, 'cache'), ('meta/*.json', ok_json, 'cache')]
+for pat, fn, kind in checks:
+    files = glob.glob(os.path.join(D, pat))
+    nbad = 0
+    for f in files:
+        if not fn(f):
+            bad.append((kind, f))
+            nbad += 1
+    print(f'{pat}: {len(files)} files, {nbad} broken')
+for kind, f in bad:
+    print('BROKEN', f)
+    if not fix:
+        continue
+    if kind == 'raw':
+        day = os.path.dirname(f)
+        for x in (f, os.path.join(day, '_done.json')):
+            if os.path.exists(x):
+                os.remove(x)
+    elif kind == 'rows':
+        day = os.path.basename(f)[:10]
+        for ext in ('.csv.gz', '.parquet', '.calls.json', '.lock'):
+            p = os.path.join(D, 'rows', day + ext)
+            if os.path.exists(p):
+                os.remove(p)
+    else:
+        os.remove(f)
+for tmp in glob.glob(os.path.join(D, '**', '*.tmp'), recursive=True):
+    print('leftover', tmp)
+    if fix:
+        os.remove(tmp)
+print(f'{len(bad)} broken files' + (' removed (their days will be fetched or built again)' if fix else ''))
