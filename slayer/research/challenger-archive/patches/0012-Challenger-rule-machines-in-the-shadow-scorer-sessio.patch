+
+/** A rule machine: a session, roots, a |delta| band, minutes since the session opened, the side the move favours
+    so far, the strike nearest a target delta; its own exit (runner false: the 1.50x take-profit). */
+export interface ShadowRule {
+  name: string;
+  session: 'overnight' | 'pre' | 'regular';
+  roots: string[];
+  delta: [number, number];
+  since: [number, number];
+  gapSide: boolean;
+  target: number;
+  runner: boolean;
+}
+
+/** The rule a row falls under (inputs in CHALLENGER_INPUTS order), and its score (nearer the target delta is higher). */
+export function ruleScore(rules: readonly ShadowRule[], ticker: string, session: string | null, c: readonly number[]): { rule: ShadowRule; score: number } | null {
+  for (const r of rules) {
+    if (session !== r.session || !r.roots.includes(ticker)) continue;
+    const d = c[14];
+    const since = c[1];
+    /* the bounds as float32, as the training rows compared them (numpy compares a float32 column in float32) */
+    const f = Math.fround;
+    if (!(d >= f(r.delta[0]) && d <= f(r.delta[1])) || !(since >= f(r.since[0]) && since <= f(r.since[1]))) continue;
+    if (r.gapSide && !(c[33] > 0)) continue;
+    return { rule: r, score: 1 - Math.abs(d - r.target) };
+  }
+  return null;
 }
 
