+++ b/slayer/research/challenger/replay_proof.sh
@@ -0,0 +1,23 @@
+#!/bin/bash
+# The before/after replay proof for 2026-10-30 (09:30-15:05): the replay harness with the code before the challenger
+# (a git archive of 6657dad in $BASE) and with this branch, both through the caching relay on :25599 so they read
+# byte-identical answers, then the two call lists compared. Run detached:
+#   BASE=/tmp/chal_base/slayer setsid nohup bash research/challenger/replay_proof.sh > research/challenger/data/replay-proof.log 2>&1 &
+HERE="$(cd "$(dirname "$0")/../.." && pwd)"
+D="$HERE/research/challenger/data"
+export REPLAY_FROM=09:30 REPLAY_CONC=3 THETA_BASE=http://127.0.0.1:25599/v3
+(cd "$BASE" && REPLAY_OUT="$D/replay-before" npx tsx scripts/compass-replay.ts 2026-10-30 > "$D/replay-before.log" 2>&1)
+(cd "$HERE" && REPLAY_OUT="$D/replay-after" npx tsx scripts/compass-replay.ts 2026-10-30 > "$D/replay-after.log" 2>&1)
+python3 - "$D" <<'EOF'
+import json, sys
+d = sys.argv[1]
+def calls(tag):
+    doc = json.load(open(f'{d}/replay-{tag}/2026-10-30.json'))
+    return [(c['book'], c['contract'], c['sleeve'], c.get('mark'), c.get('p1'), c.get('prun'), c['runner'], (c.get('outcome') or {}).get('pnl')) for c in doc['calls']], doc['marks']
+a, ma = calls('before')
+b, mb = calls('after')
+print('before', len(a), 'calls;', 'after', len(b), 'calls')
+for x in a: print('  ', x)
+same_marks = json.dumps(ma, sort_keys=True) == json.dumps(mb, sort_keys=True)
+print('SAME CALLS' if a == b else 'CALLS DIFFER', '| marks and funnels', 'identical' if same_marks else 'differ')
+EOF
