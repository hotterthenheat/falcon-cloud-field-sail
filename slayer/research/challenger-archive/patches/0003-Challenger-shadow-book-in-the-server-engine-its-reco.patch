diff --git a/slayer/scripts/challenger-parity-proof.ts b/slayer/scripts/challenger-parity-proof.ts
new file mode 100644
index 0000000..263d797
--- /dev/null
+++ b/slayer/scripts/challenger-parity-proof.ts
@@ -0,0 +1,60 @@
+/**
+ * The shadow challenger's scoring in TypeScript (src/data/lgbm.ts predict, compassChallenger isotonic and bucketOf)
+ * against LightGBM's own Booster.predict and the meta file's calibration, on 200 real rows per machine and edge
+ * vectors. Run: npx tsx scripts/challenger-parity-proof.ts
+ * The expected outputs come from research/challenger/parity_fixture.py.
+ */
+import { readFileSync, existsSync } from 'node:fs';
+import { createHash } from 'node:crypto';
+import { fileURLToPath } from 'node:url';
+import { dirname, join } from 'node:path';
+import { parseBoosters, predict } from '../src/data/lgbm.ts';
+import { bucketOf, isotonic } from '../src/data/compassChallenger.ts';
+import { CHALLENGER_META_SHA, CHALLENGER_ODTE_SHA, CHALLENGER_WEEKLY_SHA } from '../src/data/challengerParams.ts';
+import { CHALLENGER_N } from '../src/data/challengerFeatures.ts';
+
+const here = dirname(fileURLToPath(import.meta.url));
+const root = join(here, '..');
+const TOL = 1e-12;
+const fixtureFile = join(here, 'fixtures/challenger-parity.json');
+if (!existsSync(join(root, 'public/models/challenger-meta.json'))) {
+  console.log('challenger parity: no challenger model shipped; nothing to prove');
+  process.exit(0);
+}
+const fixture = JSON.parse(readFileSync(fixtureFile, 'utf8')) as { machines: Record<string, { vectors: (number | null)[][]; raw: number[]; cal: number[] }> };
+const sha = (f: string) => createHash('sha256').update(readFileSync(join(root, 'public/models', f))).digest('hex');
+let failed = 0;
+for (const [f, want] of [['challenger-meta.json', CHALLENGER_META_SHA], ['challenger-odte.txt', CHALLENGER_ODTE_SHA], ['challenger-weekly.txt', CHALLENGER_WEEKLY_SHA]] as const) {
+  if (sha(f) !== want) {
+    console.error(`FAIL: ${f} does not hash to its constant in challengerParams.ts`);
+    failed++;
+  }
+}
+const meta = JSON.parse(readFileSync(join(root, 'public/models/challenger-meta.json'), 'utf8')) as { inputs: number; machines: Record<string, { trees: number; calibration: Record<string, { x: number[]; y: number[] }> }> };
+if (meta.inputs !== CHALLENGER_N) {
+  console.error(`FAIL: meta is for ${meta.inputs} inputs, the scan builds ${CHALLENGER_N}`);
+  failed++;
+}
+for (const m of ['odte', 'weekly'] as const) {
+  const trees = parseBoosters(readFileSync(join(root, `public/models/challenger-${m}.txt`), 'utf8'), meta.machines[m].trees);
+  if (!trees) throw new Error(`${m}: did not parse as ${meta.machines[m].trees} numerical trees`);
+  const fx = fixture.machines[m];
+  let worstRaw = 0;
+  let worstCal = 0;
+  fx.vectors.forEach((row, i) => {
+    const x = row.map(v => (v == null ? NaN : Math.fround(v)));
+    const raw = predict(trees, x);
+    const cal = meta.machines[m].calibration;
+    const iso = cal[String(bucketOf(x))] ?? cal.all;
+    const pc = isotonic(iso, raw);
+    worstRaw = Math.max(worstRaw, Math.abs(raw - fx.raw[i]));
+    worstCal = Math.max(worstCal, Math.abs(pc - fx.cal[i]));
+    if (Math.abs(raw - fx.raw[i]) > TOL || Math.abs(pc - fx.cal[i]) > TOL) failed++;
+  });
+  console.log(`${m}: ${fx.vectors.length} vectors, max |ts - lightgbm| raw ${worstRaw.toExponential(2)}, calibrated ${worstCal.toExponential(2)}`);
+}
+if (failed) {
+  console.error(`FAIL: ${failed} differences over ${TOL}`);
+  process.exit(1);
+}
+console.log('challenger parity: pass');
