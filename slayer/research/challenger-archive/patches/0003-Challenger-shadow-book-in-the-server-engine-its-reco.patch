+/*
+  The shadow challenger changes nothing live. A recorded session (scripts/fixtures/challenger-day: 2026-10-30, SPY and
+  XSP same-day and weekly, GLD and AAPL same-day; the overnight marks 20:30–21:30 and the regular marks 09:45–11:00)
+  is run through the engine's own late path (atMark, scoreBook, recordPicks: the replay's loop) twice, each in its own
+  process: with the challenger off (CHALLENGER_SHADOW=0) and on. Every row the live trees scored (contract, mark,
+  Model 1, Model 2), every live would-call and the live seats must be identical; the challenger's calls live in its
+  own book only. Then its seat rules (pickShadow) are checked on a hand-built pass.
+
+    npx tsx scripts/golden/challenger-golden.ts
+*/
+import fs from 'node:fs';
+import path from 'node:path';
+import { spawnSync } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import { fileURLToPath } from 'node:url';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const root = path.join(here, '..', '..');
+const FIXTURE = path.join(here, '..', 'fixtures', 'challenger-day');
+let failed = 0;
+const check = (what: string, ok: boolean, detail = '') => {
+  console.log(`${ok ? 'PASS' : 'FAIL'}  ${what}${detail ? ` — ${detail}` : ''}`);
+  if (!ok) failed++;
+};
+
+async function pass(): Promise<void> {
+  process.env.CHAL_DATA = FIXTURE;
+  const { localTheta } = await import('../../research/challenger/localHost');
+  const { setCompassHost } = await import('../../src/data/compassHost');
+  const scan = await import('../../src/data/compassScan');
+  const model = await import('../../src/data/compassModel');
+  const ledger = await import('../../src/data/compassLedger');
+  const shadow = await import('../../src/data/compassChallenger');
+  const { nyWallTime } = await import('../../src/core/nyTime');
+  const host = localTheta('2026-10-30');
+  setCompassHost({
+    server: true,
+    theta: host.theta,
+    asset: async p => {
+      const b = fs.readFileSync(path.join(root, 'public', p.replace(/^\/+/, '')));
+      return b.buffer.slice(b.byteOffset, b.byteOffset + b.byteLength) as ArrayBuffer;
+    },
+    econ: () => [],
+  });
+  model.setScoreClose('20261030', null);
+  model.rollModelDay('20261030');
+  ledger.setSessionClose(null);
+  ledger.importSignals([]);
+  ledger.importWould([]);
+  const on = await shadow.startChallenger();
+  const rows: string[] = [];
+  model.onScoredRow(r => rows.push(`${r.minute}|${r.setup.sleeve}|${r.setup.contract}|${r.p1}|${r.prun}`));
+  const marks: number[] = [];
+  for (let m = 20 * 60 + 30; m <= 21 * 60 + 30; m += 5) marks.push(nyWallTime(2026, 10, 29, Math.floor(m / 60), m % 60));
+  for (let m = 9 * 60 + 45; m <= 11 * 60; m += 5) marks.push(nyWallTime(2026, 10, 30, Math.floor(m / 60), m % 60));
+  const jobs: { sym: string; sleeve: 'odte' | 'weekly' }[] = [
+    { sym: 'XSP', sleeve: 'odte' }, { sym: 'SPY', sleeve: 'odte' }, { sym: 'GLD', sleeve: 'odte' }, { sym: 'AAPL', sleeve: 'odte' },
+    { sym: 'SPY', sleeve: 'weekly' }, { sym: 'XSP', sleeve: 'weekly' },
+  ];
+  for (const at of marks) {
+    for (const j of jobs) {
+      const snap = await scan.atMark(j.sym, at, j.sleeve);
+      if (!snap.ok || !snap.setups.length) continue;
+      await model.scoreBook(snap.setups, at, true, true);
+      ledger.recordPicks(at);
+    }
+  }
+  const would = ledger.wouldSignals().map(s => `${s.book}|${s.contract}|${s.sleeve}|${s.mark}|${s.p1}|${s.prun}|${s.runner}`).sort();
+  const seats = model.heldSeatsAt(Number.MAX_SAFE_INTEGER, true);
+  const out = {
+    on,
+    rows: rows.length,
+    rowsHash: createHash('sha256').update(rows.join('\n')).digest('hex'),
+    would,
+    seats: [...seats].sort(),
+    official: ledger.signals().length,
+    shadow: shadow.shadowCalls().map(c => `${c.book}|${c.contract}|${c.sleeve}|${c.mark}|${c.pc}`),
+    sessions: [...new Set(shadow.shadowCalls().map(c => c.tapeSession ?? ''))],
+  };
+  process.stdout.write(`\n@@${JSON.stringify(out)}\n`);
+}
+
+if (process.argv.includes('--pass')) {
+  await pass();
+  process.exit(0);
+}
+
+const run = (env: Record<string, string>) => {
+  const r = spawnSync(process.execPath, [...process.execArgv, fileURLToPath(import.meta.url), '--pass'], { env: { ...process.env, ...env }, encoding: 'utf8', maxBuffer: 64 << 20 });
+  const line = (r.stdout ?? '').split('\n').find(l => l.startsWith('@@'));
+  if (!line) throw new Error(`pass failed: ${r.stderr?.slice(-2000)}`);
+  return JSON.parse(line.slice(2)) as { on: boolean; rows: number; rowsHash: string; would: string[]; seats: string[]; official: number; shadow: string[]; sessions: string[] };
+};
+
+const off = run({ CHALLENGER_SHADOW: '0' });
+const onR = run({});
+const shipped = fs.existsSync(path.join(root, 'public/models/challenger-meta.json'));
+check('challenger off: the shadow does not start', off.on === false);
+check('challenger on: the shadow starts (the shipped files hash to their constants)', onR.on === shipped, `shipped ${shipped}`);
+check('the live trees scored the same rows, with the same Model 1 and Model 2', off.rows === onR.rows && off.rowsHash === onR.rowsHash && off.rows > 0, `${off.rows} rows, ${off.rowsHash.slice(0, 12)}`);
+check('the same live would-calls (book, contract, mark, scores, runner)', JSON.stringify(off.would) === JSON.stringify(onR.would), `${off.would.length} calls: ${off.would.map(w => w.split('|')[1]).join(', ')}`);
+check('the same live seats', JSON.stringify(off.seats) === JSON.stringify(onR.seats), off.seats.join(', '));
+check('no official call in either pass (a late mark never calls)', off.official === 0 && onR.official === 0);
+check('the off pass has no shadow call', off.shadow.length === 0);
+if (shipped) check('the shadow book is its own (at most five calls, one a root)', onR.shadow.length <= 5 && new Set(onR.shadow.map(s => s.split('|')[1].split(' ')[0])).size === onR.shadow.length, `${onR.shadow.length} shadow calls (${onR.shadow.join('; ')}) in ${onR.sessions.join(', ') || 'no session'}`);
+
+/* the shadow's seat rules on a hand-built pass */
+{
+  const { pickShadow } = await import('../../src/data/compassChallenger');
+  const mk = (ticker: string, strike: number, right: 'C' | 'P', pc: number, a: boolean, retOpen = 0.001) => ({
+    machine: 'odte' as const, raw: pc, pc,
+    row: { setup: { id: `${ticker}-${strike}-${right}-top-setups-odte`, ticker, right, strike }, gates: { aGate: a, bGate: !a, retOpen }, prun: null } as never,
+  });
+  const held = { roots: new Set<string>(['AAA', 'BBB', 'CCC']), ids: new Set<string>() };
+  const got = pickShadow([mk('SPY', 500, 'C', 0.6, true), mk('SPY', 501, 'C', 0.7, true), mk('QQQ', 400, 'C', 0.8, true), mk('QQQ', 399, 'P', 0.9, true), mk('IWM', 200, 'P', 0.65, true), mk('TLT', 90, 'C', 0.95, false)], held);
+  /* QQQ is flat with both sides: neither; the highest of the rest first; two seats left */
+  check('seats: a flat root with both sides calls neither; best first; five seats', JSON.stringify(got.map(c => (c.row.setup as { id: string }).id)) === JSON.stringify(['TLT-90-C-top-setups-odte', 'SPY-501-C-top-setups-odte']), got.map(c => (c.row.setup as { id: string }).id).join(', '));
+  const drive = pickShadow([mk('SPY', 500, 'C', 0.6, true, 0.01), mk('SPY', 498, 'P', 0.9, true, 0.01), mk('QQQ', 400, 'C', 0.95, true, 0.0)], { roots: new Set(), ids: new Set() });
+  check('seats: a drive calls its own side, and drive candidates go first (only drives when one is there)', JSON.stringify(drive.map(c => (c.row.setup as { id: string }).id)) === JSON.stringify(['SPY-500-C-top-setups-odte']));
+}
+
+if (failed) {
+  console.error(`challenger golden: ${failed} failed`);
+  process.exit(1);
+}
+console.log('challenger golden: pass');
