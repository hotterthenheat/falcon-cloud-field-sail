index 0000000..f4639e8
--- /dev/null
+++ b/slayer/research/challenger/moves.py
@@ -0,0 +1,120 @@
+"""How moves happen: every Book A/B candidate row (inside the entry minutes, past the spread, with a fill) split into
+movers (the bid reached 1.50x the fill before the row's own flat) and the rest, the movers' P&L to that moment
+decomposed along the path (delta dS + 1/2 gamma dS^2 + vega dsigma + theta dt + residual, greeks at the mark, the
+underlying from the chain's put-call parity), classified into move types, and what preceded each type at the
+decision time measured against the rows that did not move in the same context (median and AUC).
+
+  python -I research/challenger/moves.py > research/challenger/data/moves.md
+"""
+import os, sys
+import numpy as np
+import pandas as pd
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import common as C
+
+FEAT = {
+    'c9': 'moneyness in expected moves (+ ITM)',
+    'c18': 'premium / expected move',
+    'c11': 'spread / mid',
+    'c26': 'realised / implied, 30 min',
+    'c27': 'efficiency ratio, 30 min',
+    'c23': '15-min forward return, signed',
+    'c29': 'ATM IV 15-min change',
+    'c32': 'skew 30-min change',
+    'c47': 'ATM IV / HAR forecast',
+    'c51': 'net / gross dealer gamma',
+    'c49': 'SPY vol shock (15 min / day)',
+    'c33': 'gap vs prior close, signed',
+    'c16': 'theta / mid',
+    'c6': 'days to expiry',
+    'c1': 'minutes since session open',
+}
+
+
+def auc(pos, neg):
+    pos = pos[np.isfinite(pos)]
+    neg = neg[np.isfinite(neg)]
+    if len(pos) < 30 or len(neg) < 30:
+        return np.nan
+    allv = np.concatenate([pos, neg])
+    ranks = pd.Series(allv).rank().values
+    rp = ranks[:len(pos)].sum()
+    return (rp - len(pos) * (len(pos) + 1) / 2) / (len(pos) * len(neg))
+
+
+def classify(df):
+    gain = df[['atDelta', 'atGamma', 'atVega', 'atTheta', 'atResid']].sum(axis=1)
+    sess = df['session'].astype(str)
+    t = df['c3']
+    zero = df['sleeve'] == 'odte'
+    kind = np.full(len(df), 'underlying trend (delta)', dtype=object)
+    vega = df['atVega'] >= 0.5 * gain
+    gamma = zero & (df['atGamma'] >= 0.35 * gain)
+    kind[(df['atDelta'] < 0.5 * gain) & ~vega & ~gamma] = 'mixed / residual'
+    kind[gamma] = 'gamma acceleration (0DTE)'
+    kind[vega] = 'IV expansion'
+    kind[(sess == 'regular') & zero & (t >= 270)] = 'late-day break (0DTE, after 14:00)'
+    kind[(sess == 'regular') & (t < 45) & (df['min50'] <= 30)] = 'opening auction (first 45 min, +50% in 30)'
+    kind[sess == 'pre'] = 'pre-market'
+    kind[sess == 'overnight'] = 'overnight (GTH)'
+    return kind
+
+
+def main():
+    days = C.days_built()
+    df = C.load(days)
+    df = df[df['fill'].notna()].copy()
+    df['mover'] = df['hit50'] == 1
+    print(f'# How moves happen (generated)\n\n{len(days)} sessions ({days[0]} to {days[-1]}), {len(df):,} candidate rows with a fill, '
+          f'{int(df.mover.sum()):,} movers (bid reached 1.50x the fill before the flat).\n')
+    for sleeve, name in (('odte', 'Same-day (0DTE)'), ('weekly', '1-7 DTE')):
+        d = df[df['sleeve'] == sleeve].copy()
+        if not len(d):
+            continue
+        d['kind'] = classify(d)
+        m = d[d.mover]
+        print(f'## {name}: {len(d):,} rows, {len(m):,} movers ({100 * len(m) / len(d):.1f}%)\n')
+        print('| move type | movers | share | median min to +50% | delta | gamma | vega | theta | residual | median dS/S | median d(IV) |')
+        print('|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|')
+        for k, g in m.groupby('kind'):
+            ds = (g['atS1'] / g['atS0'] - 1).median() * 100
+            div = (g['atIv1'] - g['atIv0']).median() * 100
+            comp = [g[c].median() * 100 for c in ('atDelta', 'atGamma', 'atVega', 'atTheta', 'atResid')]
+            print(f'| {k} | {len(g):,} | {100 * len(g) / len(m):.1f}% | {g.min50.median():.0f} | ' + ' | '.join(f'{v:+.0f}%' for v in comp) + f' | {ds:+.2f}% | {div:+.1f} pts |')
+        print('\n(Attribution: share of the mark\'s mid, greeks at the mark, to the minute the bid first reached 1.50x the fill.)\n')
+        print('### By session and time of day: how often a candidate moves\n')
+        d['tod'] = np.where(d['session'] != 'regular', d['session'].astype(str), pd.cut(d['c3'], [-1, 30, 60, 120, 180, 240, 300, 400], labels=['09:30-10:00', '10:00-10:30', '10:30-11:30', '11:30-12:30', '12:30-13:30', '13:30-14:30', '14:30+']).astype(str))
+        print('| when | rows | movers | rate | mean P&L as A non-runner ($/contract) |')
+        print('|---|---:|---:|---:|---:|')
+        for k, g in d.groupby('tod'):
+            print(f'| {k} | {len(g):,} | {int(g.mover.sum()):,} | {100 * g.mover.mean():.1f}% | {g.pnlA.mean():+.1f} |')
+        print('\n### What preceded a move (at the decision time): movers vs non-movers, same sleeve\n')
+        print('| input | median, movers | median, non-movers | AUC (mover vs not) |')
+        print('|---|---:|---:|---:|')
+        for c, label in FEAT.items():
+            a = auc(d.loc[d.mover, c].values.astype(float), d.loc[~d.mover, c].values.astype(float))
+            print(f'| {label} | {d.loc[d.mover, c].median():.4g} | {d.loc[~d.mover, c].median():.4g} | {a:.3f} |')
+        print('\n### Per move type: the inputs that separate it most from the non-movers of its context (|AUC - 0.5|)\n')
+        for k, g in m.groupby('kind'):
+            ctx = d[~d.mover]
+            if k.startswith('overnight'):
+                ctx = ctx[ctx.session == 'overnight']
+            elif k.startswith('pre'):
+                ctx = ctx[ctx.session == 'pre']
+            elif k.startswith('opening'):
+                ctx = ctx[(ctx.session == 'regular') & (ctx.c3 < 45)]
+            elif k.startswith('late'):
+                ctx = ctx[(ctx.session == 'regular') & (ctx.c3 >= 270)]
+            scores = []
+            for c, label in FEAT.items():
+                a = auc(g[c].values.astype(float), ctx[c].values.astype(float))
+                if np.isfinite(a):
+                    scores.append((abs(a - 0.5), a, label, g[c].median(), ctx[c].median()))
+            scores.sort(reverse=True)
+            top = '; '.join(f'{lab} AUC {a:.2f} ({mv:.3g} vs {nv:.3g})' for _, a, lab, mv, nv in scores[:4])
+            print(f'- **{k}** ({len(g):,}): {top}')
+        print()
+
+
+if __name__ == '__main__':
+    main()
