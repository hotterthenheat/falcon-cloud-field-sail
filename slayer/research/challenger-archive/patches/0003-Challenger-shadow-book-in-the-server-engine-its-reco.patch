diff --git a/slayer/research/challenger/evaluate.py b/slayer/research/challenger/evaluate.py
new file mode 100644
index 0000000..f2f295d
--- /dev/null
+++ b/slayer/research/challenger/evaluate.py
@@ -0,0 +1,117 @@
+"""Held-out comparison: the challenger's calls against the current book's on the same sessions, same seats, same
+exits (no fees), from a walk-forward run (train.py writes data/wf/<tag>/heldout_scores.parquet).
+
+  python -I research/challenger/evaluate.py --tag v1 [--json out.json]
+
+Books compared, each through its own five seats a session:
+  - Hit score (current Books A/B): Model 1 >= 0.7067, Book A rides when the Runner score >= 0.50, Book B rides;
+  - Hit score, never riding (the Runner score's contribution: the same calls with Book A taking 1.50x);
+  - Late sweep (Book C): the engine's own 15:20 sweep and its settlement (one-second exits);
+  - Challenger: each sleeve's machine, calibrated, at its fold's line, the same seats and the same exits.
+Intervals: session-block bootstrap (2,000 resamples of whole sessions); the paired difference resamples the same
+sessions for both books.
+"""
+import argparse, json, os, sys
+import numpy as np
+import pandas as pd
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import common as C
+
+
+def by_day(df, idx, pnl, days):
+    out = {d: [] for d in days}
+    for i in idx:
+        if np.isfinite(pnl[i]):  # a call with no fill quote is unavailable: no P&L, as on the record
+            out[df.at[i, 'day']].append(float(pnl[i]))
+    return out
+
+
+def line(name, per, extra=''):
+    flat = [v for vs in per.values() for v in vs]
+    n = len(flat)
+    if not n:
+        return {'book': name, 'calls': 0}
+    pc = C.block_boot(per, 'mean_call')
+    pd_ = C.block_boot(per, 'mean_day')
+    worst = min(flat)
+    return {'book': name, 'sessions': len(per), 'calls': n, 'hit': float(np.mean([v > 0 for v in flat])), 'avg_call': pc[0], 'call_lo': pc[1], 'call_hi': pc[2],
+            'per_day': pd_[0], 'day_lo': pd_[1], 'day_hi': pd_[2], 'total': float(sum(flat)), 'worst': worst, 'note': extra}
+
+
+def fmt(r):
+    if not r.get('calls'):
+        return f"| {r['book']} | 0 | | | | | | |"
+    return (f"| {r['book']} | {r['calls']} | {100 * r['hit']:.0f}% | {r['avg_call']:+.1f} [{r['call_lo']:+.1f}, {r['call_hi']:+.1f}] | "
+            f"{r['per_day']:+.1f} [{r['day_lo']:+.1f}, {r['day_hi']:+.1f}] | {r['total']:+,.0f} | {r['worst']:+.0f} |")
+
+
+def sessions_table(title, rows):
+    print(f'\n**{title}**\n')
+    print('| book | calls | hit | $/call [95%] | $/session [95%] | total $ | worst $ |')
+    print('|---|---:|---:|---:|---:|---:|---:|')
+    for r in rows:
+        print(fmt(r))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--tag', default='v1')
+    ap.add_argument('--json', default='')
+    a = ap.parse_args()
+    wf = os.path.join(C.DATA, 'wf', a.tag)
+    h = pd.read_parquet(os.path.join(wf, 'heldout_scores.parquet'))
+    days = sorted(h['day'].unique())
+    df = C.load(days)
+    df = df.reset_index(drop=True)
+    key = ['day', 'sleeve', 'contract', 'mark']
+    df = df.merge(h[key + ['chal', 'line']].drop_duplicates(key), on=key, how='left')
+    pnl, _ = C.call_pnl(df)
+    pnl_none, _ = C.call_pnl(df, 'none')
+    results = {}
+
+    def books(sub, label):
+        sdays = sorted(sub['day'].unique())
+        cur = C.simulate(sub, sub['p1'].values, C.P1_MIN)
+        chal = C.simulate(sub, sub['chal'].values, sub['line'].values)
+        rows = [line('Hit score + Runner score (current A/B)', by_day(df, cur, pnl, sdays)),
+                line('Hit score, no runner ride', by_day(df, cur, pnl_none, sdays))]
+        late = {d: [] for d in sdays}
+        for d in sdays:
+            for c in C.engine_calls(d):
+                if c['book'] == 'C' and c.get('outcome') and c['outcome'].get('pnl') is not None:
+                    late[d].append(float(c['outcome']['pnl']))
+        rows.append(line('Late sweep (Book C)', late))
+        rows.append(line('Challenger (both machines)', by_day(df, chal, pnl, sdays)))
+        cd = by_day(df, chal, pnl, sdays)
+        diffs = {}
+        for name, other in (('Hit score + Runner', by_day(df, cur, pnl, sdays)), ('Late sweep', late)):
+            diffs[name] = {'per_call': C.paired_boot(cd, other, 'mean_call'), 'per_day': C.paired_boot(cd, other, 'mean_day')}
+        results[label] = {'rows': rows, 'diff': diffs}
+        sessions_table(f'{label} ({len(sdays)} held-out sessions)', rows)
+        print('\nChallenger minus each book, same sessions (paired session bootstrap, 95%):\n')
+        for name, dd in diffs.items():
+            print(f"- vs {name}: per call {dd['per_call'][0]:+.1f} [{dd['per_call'][1]:+.1f}, {dd['per_call'][2]:+.1f}]; per session {dd['per_day'][0]:+.1f} [{dd['per_day'][1]:+.1f}, {dd['per_day'][2]:+.1f}]")
+        return cur, chal
+
+    cur, chal = books(df, 'All held-out sessions')
+    # by machine and by session type: the calls each book made there
+    for title, mask in (('Same-day machine', df['sleeve'] == 'odte'), ('1-7 DTE machine', df['sleeve'] == 'weekly')):
+        sdays = sorted(df['day'].unique())
+        rows = [line('Hit score + Runner (its calls in this sleeve)', by_day(df, [i for i in cur if mask[i]], pnl, sdays)),
+                line('Challenger (its calls in this sleeve)', by_day(df, [i for i in chal if mask[i]], pnl, sdays))]
+        sessions_table(title, rows)
+        results[title] = {'rows': rows}
+    for sess in ('overnight', 'pre', 'regular'):
+        m = df['session'] == sess
+        sdays = sorted(df['day'].unique())
+        rows = [line('Hit score + Runner', by_day(df, [i for i in cur if m[i]], pnl, sdays)),
+                line('Challenger', by_day(df, [i for i in chal if m[i]], pnl, sdays))]
+        sessions_table(f'Calls made in the {sess} session', rows)
+        results[f'session {sess}'] = {'rows': rows}
+    if a.json:
+        with open(a.json, 'w') as f:
+            json.dump(results, f, indent=1, default=float)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/slayer/research/challenger/make_golden_fixture.py b/slayer/research/challenger/make_golden_fixture.py
new file mode 100644
index 0000000..b3013c5
--- /dev/null
+++ b/slayer/research/challenger/make_golden_fixture.py
@@ -0,0 +1,53 @@
+"""Cuts the challenger golden's fixture out of the bulk cache: one recorded session (2026-10-30), four names (SPY and
+XSP same-day and weekly, GLD and AAPL same-day), the overnight marks 20:30-21:30 and the regular marks 09:45-11:00,
+with the bars the engine reads for them (the day, the prior session, the three-week volume curve, GLD's sector ETF).
+
+  python -I research/challenger/make_golden_fixture.py <slayer dir>
+"""
+import gzip, json, os, shutil, sys
+
+root = sys.argv[1]
+src = os.path.join(root, 'research/challenger/data')
+dst = os.path.join(root, 'scripts/fixtures/challenger-day')
+DAY = '20261030'
+if os.path.exists(dst):
+    shutil.rmtree(dst)
+os.makedirs(os.path.join(dst, 'raw', DAY))
+done = json.load(open(os.path.join(src, 'raw', DAY, '_done.json')))
+names = {'SPY', 'XSP', 'GLD', 'AAPL'}
+weekly = {r: e for r, e in done['weekly'] if r in {'SPY', 'XSP'}}
+files = [f'{r}_{DAY}' for r in names] + [f'{r}_{e.replace("-", "")}' for r, e in weekly.items()]
+
+
+def keep(key):
+    d, hm = key[:10], key[11:16]
+    if d == '2026-10-29':
+        return '20:00' <= hm <= '21:31'
+    return '09:14' <= hm <= '11:01'
+
+
+for f in files:
+    for ext in ('.csv.gz', '.oi.csv.gz'):
+        p = os.path.join(src, 'raw', DAY, f + ext)
+        if not os.path.exists(p):
+            continue
+        lines = gzip.open(p, 'rt').read().split('\n')
+        if ext == '.csv.gz':
+            lines = [l for l in lines if l and keep(l[:16])]
+        with gzip.open(os.path.join(dst, 'raw', DAY, f + ext), 'wt') as o:
+            o.write('\n'.join(lines))
+json.dump({'day': '2026-10-30', 'odte': sorted(names), 'weekly': [[r, e] for r, e in weekly.items()]}, open(os.path.join(dst, 'raw', DAY, '_done.json'), 'w'))
+os.makedirs(os.path.join(dst, 'meta'))
+for r in names:
+    shutil.copy(os.path.join(src, 'meta', f'exp_{r}.json'), os.path.join(dst, 'meta', f'exp_{r}.json'))
+for sym in ('SPY', 'XSP', 'GLD', 'AAPL', 'GDX'):
+    for month in ('2026-09', '2026-10'):
+        p = os.path.join(src, 'bars', sym, f'{month}.csv.gz')
+        if not os.path.exists(p):
+            continue
+        lines = [l for l in gzip.open(p, 'rt').read().split('\n') if l and '2026-10-01' <= l[:10] <= '2026-10-30' or (l and l[:7] == '2026-09' and l[:10] >= '2026-09-28')]
+        os.makedirs(os.path.join(dst, 'bars', sym), exist_ok=True)
+        with gzip.open(os.path.join(dst, 'bars', sym, f'{month}.csv.gz'), 'wt') as o:
+            o.write('\n'.join(lines))
+total = sum(os.path.getsize(os.path.join(dp, f)) for dp, _, fs in os.walk(dst) for f in fs)
+print(dst, f'{total / 1e6:.2f} MB')
