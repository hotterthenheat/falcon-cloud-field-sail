@@ -0,0 +1,7 @@
+/* The shadow challenger's lock: its own files and hashes, apart from the live models' (compassParams.ts). The live
+   scan never reads these. A file that does not hash to its constant leaves the shadow off. */
+
+export const CHALLENGER_NAME = 'Challenger · shadow';
+export const CHALLENGER_ODTE_SHA = '';
+export const CHALLENGER_WEEKLY_SHA = '';
+export const CHALLENGER_META_SHA = '';
diff --git a/slayer/src/data/compassChallenger.ts b/slayer/src/data/compassChallenger.ts
new file mode 100644
index 0000000..214667b
--- /dev/null
+++ b/slayer/src/data/compassChallenger.ts
@@ -0,0 +1,357 @@
+/*
+  The challenger, in shadow. Two machines (the same-day sleeve and the 1-7 DTE sleeve) score every row the scan
+  already built inputs for (compassModel onFeatureRow: no request of their own), through the same gates, the same five
+  seats a session, one call a root and the same exits as the live books, in a book of their own. They never place a
+  call, never take a live seat and never change what a viewer sees as a call: what they would call is kept in the
+  session record's `challenger` section, settled by the ledger's own path reads and rules, and shown apart on the
+  Blotter as "Challenger · shadow". CHALLENGER_SHADOW=0 turns it off. Promotion is the owner's decision.
+
+  The models, their calibration and the line are fixed files (public/models/challenger-*.txt, challenger-meta.json)
+  locked by their own hashes (challengerParams.ts), separate from the live models' (compassParams.ts).
+*/
+
+import { firstNaN, nanUnsafeColumns, parseBoosters, predict, type Tree } from './lgbm';
+import { compassHost } from './compassHost';
+import { onFeatureRow, underCloses, type FeatureBatch, type FeatureRow } from './compassModel';
+import { challengerFeatures, CHALLENGER_N } from './challengerFeatures';
+import { contractPath, withFineExits, type Signal } from './compassLedger';
+import { settleSignal } from './compassOutcome';
+import { DRIVE, SEAT_CAP, runnerFlag } from './compassParams';
+import { CHALLENGER_META_SHA, CHALLENGER_ODTE_SHA, CHALLENGER_WEEKLY_SHA, CHALLENGER_NAME } from './challengerParams';
+import { sessionIso } from './compassSession';
+import { nyParts } from '../core/nyTime';
+
+export type Machine = 'odte' | 'weekly';
+
+/** One shadow call: a ledger Signal (so the same settlement and track record read it) marked as the challenger's. */
+export interface ShadowCall extends Signal {
+  shadow: 'challenger';
+  machine: Machine;
+  /** the machine's calibrated probability of the 1.50x before the stop, and its raw score */
+  pc: number;
+  raw: number;
+  line: number;
+}
+
+export interface ChallengerRecord {
+  format: 'compass-challenger/1';
+  day: string;
+  models: { odte: string; weekly: string; meta: string };
+  line: number | null;
+  calls: ShadowCall[];
+}
+
+interface Iso { x: number[]; y: number[] }
+interface Meta {
+  format: string;
+  inputs: number;
+  line: number;
+  machines: Record<Machine, { trees: number; calibration: Record<string, Iso> }>;
+}
+
+let trees: Record<Machine, Tree[]> | null = null;
+let unsafe: Record<Machine, number[]> = { odte: [], weekly: [] };
+let meta: Meta | null = null;
+let loadState: 'idle' | 'loading' | 'ready' | 'off' = 'idle';
+let lockText = '';
+
+async function sha256Hex(bytes: ArrayBuffer): Promise<string> {
+  const digest = await crypto.subtle.digest('SHA-256', bytes);
+  return [...new Uint8Array(digest)].map(b => b.toString(16).padStart(2, '0')).join('');
+}
+
+/** The machines, their calibration and the line, if every file hashes to its constant. */
+export async function loadChallenger(): Promise<boolean> {
+  if (loadState === 'ready') return true;
+  if (loadState === 'loading' || loadState === 'off') return false;
+  loadState = 'loading';
+  try {
+    const want: [string, string][] = [['/models/challenger-meta.json', CHALLENGER_META_SHA], ['/models/challenger-odte.txt', CHALLENGER_ODTE_SHA], ['/models/challenger-weekly.txt', CHALLENGER_WEEKLY_SHA]];
+    const bytes: ArrayBuffer[] = [];
+    for (const [url, sha] of want) {
+      const b = await compassHost().asset(url);
+      if (!b) throw new Error(`${url} is missing`);
+      const got = await sha256Hex(b);
+      if (got !== sha) throw new Error(`${url} hashes to ${got.slice(0, 12)}…, not ${sha.slice(0, 12)}…`);
+      bytes.push(b);
+    }
+    const dec = new TextDecoder();
+    const m = JSON.parse(dec.decode(bytes[0])) as Meta;
+    if (m.inputs !== CHALLENGER_N) throw new Error(`the meta file is for ${m.inputs} inputs, not ${CHALLENGER_N}`);
+    const t0 = parseBoosters(dec.decode(bytes[1]), m.machines.odte.trees);
+    const t1 = parseBoosters(dec.decode(bytes[2]), m.machines.weekly.trees);
+    if (!t0 || !t1) throw new Error('a challenger model is not the trees its meta file names');
+    trees = { odte: t0, weekly: t1 };
+    unsafe = { odte: nanUnsafeColumns(dec.decode(bytes[1])), weekly: nanUnsafeColumns(dec.decode(bytes[2])) };
+    meta = m;
+    loadState = 'ready';
+    lockText = '';
+    return true;
+  } catch (e) {
+    lockText = `${CHALLENGER_NAME} not loaded: ${(e as Error).message}`;
+    loadState = 'off';
+    return false;
+  }
+}
+
+export function challengerLock(): string {
+  return lockText;
+}
+
+/** For the proofs: the loaded machines and line (null until loadChallenger). */
+export function challengerModels(): { trees: Record<Machine, Tree[]>; meta: Meta } | null {
+  return trees && meta ? { trees, meta } : null;
+}
+
+/** sklearn's IsotonicRegression.predict: linear between the fitted points, clipped at the ends. */
+export function isotonic(m: Iso, v: number): number {
+  const { x, y } = m;
+  if (!x.length) return NaN;
+  if (v <= x[0]) return y[0];
+  if (v >= x[x.length - 1]) return y[y.length - 1];
+  let lo = 0;
+  let hi = x.length - 1;
+  while (hi - lo > 1) {
+    const mid = (lo + hi) >> 1;
+    if (x[mid] <= v) lo = mid;
+    else hi = mid;
+  }
+  if (x[hi] === x[lo]) return y[hi];
+  return y[lo] + ((y[hi] - y[lo]) * (v - x[lo])) / (x[hi] - x[lo]);
+}
+
+/** The time-of-day bucket a row is calibrated in (train.py bucket): overnight, pre-market, four regular windows. */
+export function bucketOf(c: readonly number[]): number {
+  const k = c[0];
+  const t = c[3];
+  if (k === 0) return 0;
+  if (k === 1) return 1;
+  if (k === 2) return t < 60 ? 2 : t < 150 ? 3 : t < 270 ? 4 : 5;
+  return 9;
+}
+
+/** One row through its machine: raw score and calibrated probability, or null where an input the trees never saw
+    missing is missing. */
+export function scoreChallenger(machine: Machine, c: readonly number[]): { raw: number; pc: number } | null {
+  if (!trees || !meta) return null;
+  if (firstNaN(c, unsafe[machine]) >= 0) return null;
+  const raw = predict(trees[machine], c);
+  const cal = meta.machines[machine].calibration;
+  const m = cal[String(bucketOf(c))] ?? cal.all;
+  return { raw, pc: m ? isotonic(m, raw) : raw };
+}
+
+/* ---- the shadow book: one session at a time ---- */
+
+interface Cand { row: FeatureRow; machine: Machine; raw: number; pc: number }
+let day = '';
+let calls: ShadowCall[] = [];
+let older: ShadowCall[] = [];
+const roots = new Set<string>();
+const ids = new Set<string>();
+const pending = new Map<number, Cand[]>();
+const changeFns = new Set<() => void>();
+let off: (() => void) | null = null;
+
+function changed(): void {
+  for (const fn of changeFns) fn();
+}
+
+export function onChallengerChange(fn: () => void): () => void {
+  changeFns.add(fn);
+  return () => changeFns.delete(fn);
+}
+
+function rollTo(next: string): void {
+  if (next === day) return;
+  if (day) older = [...calls, ...older].slice(0, 400);
+  day = next;
+  calls = [];
+  roots.clear();
+  ids.clear();
+  pending.clear();
+}
+
+function onRow(r: FeatureRow): void {
+  if (!trees || !meta) return;
+  if (!r.gates.entryOk || !(r.gates.aGate || r.gates.bGate) || r.gates.burns) return;
+  const machine: Machine = r.setup.sleeve === 'weekly' ? 'weekly' : 'odte';
+  const c = challengerFeatures(r);
+  const s = scoreChallenger(machine, c);
+  if (!s || !(s.pc + 1e-12 >= meta.line)) return;
+  const list = pending.get(r.batch) ?? [];
+  list.push({ row: r, machine, raw: s.raw, pc: s.pc });
+  pending.set(r.batch, list);
+}
+
+/** The scan's seat rules over one scoring pass (compassModel scoreRows; research/challenger/common.py simulate). */
+export function pickShadow(cands: readonly Cand[], held: { roots: Set<string>; ids: Set<string> }): Cand[] {
+  const out: Cand[] = [];
+  if (held.roots.size >= SEAT_CAP) return out;
+  const choose = (pool: readonly Cand[]): { c: Cand; drive: boolean }[] => {
+    const byRoot = new Map<string, Cand[]>();
+    for (const c of pool) {
+      const l = byRoot.get(c.row.setup.ticker) ?? [];
+      l.push(c);
+      byRoot.set(c.row.setup.ticker, l);
+    }
+    const res: { c: Cand; drive: boolean }[] = [];
+    for (const list of byRoot.values()) {
+      const ret = list.find(c => Number.isFinite(c.row.gates.retOpen))?.row.gates.retOpen ?? NaN;
+      const drive = Number.isFinite(ret) && Math.abs(ret) >= DRIVE;
+      const best = (xs: Cand[]) => xs.reduce((a, b) => (b.pc > a.pc ? b : a));
+      if (drive) {
+        const side = list.filter(c => c.row.setup.right === (ret > 0 ? 'C' : 'P'));
+        if (side.length) res.push({ c: best(side), drive });
+        continue;
+      }
+      if (list.some(c => c.row.setup.right === 'C') && list.some(c => c.row.setup.right === 'P')) continue;
+      res.push({ c: best(list), drive });
+    }
+    return res;
+  };
+  const cands2 = [...choose(cands.filter(c => c.row.gates.aGate)), ...choose(cands.filter(c => !c.row.gates.aGate && c.row.gates.bGate))]
+    .sort((a, b) => Number(b.drive) - Number(a.drive) || b.c.pc - a.c.pc);
+  const anyDrive = cands2.some(c => c.drive);
+  for (const { c, drive } of cands2) {
+    if (anyDrive && !drive) continue;
+    const t = c.row.setup.ticker;
+    if (held.roots.size >= SEAT_CAP || held.roots.has(t) || held.ids.has(c.row.setup.id)) continue;
+    held.roots.add(t);
+    held.ids.add(c.row.setup.id);
+    out.push(c);
+  }
+  return out;
+}
+
+function onBatch(b: FeatureBatch): void {
+  const list = pending.get(b.batch);
+  pending.delete(b.batch);
+  rollTo(sessionIso(b.now));
+  if (!list?.length || !meta) return;
+  const picked = pickShadow(list, { roots, ids });
+  for (const c of picked) {
+    const s = c.row.setup;
+    const book: 'A' | 'B' = c.row.gates.aGate ? 'A' : 'B';
+    const runner = book === 'B' || (c.row.prun != null && runnerFlag(c.row.prun));
+    const p = nyParts(b.mark);
+    const sig: ShadowCall = {
+      key: `${day}|${s.id}|challenger`,
+      id: s.id,
+      day: `${p.year}-${String(p.month).padStart(2, '0')}-${String(p.day).padStart(2, '0')}`,
+      book,
+      ticker: s.ticker,
+      contract: s.contract,
+      right: s.right,
+      strike: s.strike,
+      expiry: s.expiryDate,
+      sleeve: s.sleeve,
+      firedAt: b.late ? b.now : Date.now(),
+      quoteAt: s.quotedAt ?? b.now,
+      bid: s.bid,
+      ask: s.ask,
+      spot: s.spot ?? null,
+      p1: c.row.p1,
+      prun: c.row.prun,
+      runner,
+      outcome: null,
+      pathAt: 0,
+      spark: [],
+      how: b.late ? 'late' : 'live',
+      mark: b.mark,
+      ...(c.row.gates.session ? { tapeSession: c.row.gates.session } : {}),
+      flatAt: c.row.gates.flatAt,
+      shadow: 'challenger',
+      machine: c.machine,
+      pc: Number(c.pc.toFixed(6)),
+      raw: Number(c.raw.toFixed(6)),
+      line: meta.line,
+    };
+    calls = [sig, ...calls];
+  }
+  if (picked.length) changed();
+}
+
+/** Start the shadow (the server's scanner role). Off with CHALLENGER_SHADOW=0 or when the files do not verify. */
+export async function startChallenger(log: (line: string) => void = () => {}): Promise<boolean> {
+  if (off) return true;
+  if (typeof process !== 'undefined' && process.env?.CHALLENGER_SHADOW === '0') {
+    log(`[compass] ${CHALLENGER_NAME}: off (CHALLENGER_SHADOW=0)`);
+    return false;
+  }
+  if (!(await loadChallenger())) {
+    log(`[compass] ${challengerLock()}`);
+    return false;
+  }
+  off = onFeatureRow(onRow, onBatch);
+  log(`[compass] ${CHALLENGER_NAME}: scoring in shadow, line ${meta?.line}`);
+  return true;
+}
+
+export function stopChallenger(): void {
+  off?.();
+  off = null;
+  pending.clear();
+}
+
+/** The session's shadow record (the day file's `challenger` section). */
+export function exportChallenger(forDay: string): ChallengerRecord {
+  return {
+    format: 'compass-challenger/1',
+    day: forDay,
+    models: { odte: CHALLENGER_ODTE_SHA, weekly: CHALLENGER_WEEKLY_SHA, meta: CHALLENGER_META_SHA },
+    line: meta?.line ?? null,
+    calls: forDay === day ? calls : older.filter(c => sessionIso(c.firedAt) === forDay),
+  };
+}
+
+/** Resume a session's shadow record (and the four before it, for the track record). */
+export function importChallenger(today: string, rec: ChallengerRecord | null | undefined, before: readonly ShadowCall[] = []): void {
+  day = today;
+  calls = (rec?.calls ?? []).filter(c => c && c.shadow === 'challenger');
+  older = [...before];
+  roots.clear();
+  ids.clear();
+  for (const c of calls) {
+    roots.add(c.ticker);
+    ids.add(c.id);
+  }
+  pending.clear();
+}
+
+/** This session's shadow calls and the ones before it that are still held, newest first. */
+export function shadowCalls(): ShadowCall[] {
+  return [...calls, ...older];
+}
+
+let settling = false;
+
+/** Settle every open shadow call by the ledger's own reads and rules (contractPath, the 1-second stop and target
+    minutes, settleSignal). The live engine runs it once a minute. */
+export async function settleChallenger(): Promise<void> {
+  if (settling || !compassHost().server) return;
+  settling = true;
+  try {
+    for (const sig of [...calls, ...older]) {
+      if (sig.outcome && (sig.outcome.status === 'closed' || sig.outcome.status === 'unavailable')) continue;
+      if (Date.now() - sig.pathAt < 50_000) continue;
+      const quotes = await contractPath(sig, sig.outcome?.fill?.at ?? null);
+      if (!quotes) continue;
+      const under = await underCloses(sig.ticker, sig.day.replace(/-/g, ''));
+      const path = await withFineExits(sig, quotes);
+      const out = settleSignal(sig, path, under, Date.now());
+      const after = quotes.filter(q => q.t > sig.firedAt && q.t % 60_000 === 0 && (!out.exit || q.t <= out.exit.at));
+      const next: ShadowCall = { ...sig, outcome: out, pathAt: Date.now(), spark: after.map(q => q.bid).filter(b => b >= 0) };
+      calls = calls.map(r => (r.key === sig.key ? next : r));
+      older = older.map(r => (r.key === sig.key ? next : r));
+      changed();
+    }
+  } finally {
+    settling = false;
+  }
+}
+
+/** For the proofs and the replay: the shadow's state reset to an empty session. */
+export function resetChallenger(forDay = ''): void {
+  importChallenger(forDay, null, []);
+}
