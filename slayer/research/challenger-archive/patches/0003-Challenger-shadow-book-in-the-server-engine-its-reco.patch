@@ -0,0 +1,48 @@
+"""Regenerates scripts/fixtures/challenger-parity.json: 200 real challenger rows per machine (from the built rows,
+float32 as the scan builds them) plus edge vectors, with LightGBM's own Booster.predict and the calibration the
+meta file holds (sklearn IsotonicRegression.predict is linear interpolation clipped at the ends: np.interp).
+
+  python -I research/challenger/parity_fixture.py <slayer dir>
+"""
+import json, os, sys
+import numpy as np
+import lightgbm as lgb
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import common as C
+
+root = sys.argv[1]
+meta = json.load(open(os.path.join(root, 'public/models/challenger-meta.json')))
+days = C.days_built()
+df = C.load(days[-3:])
+rng = np.random.default_rng(20261031)
+out = {'source': f'LightGBM {lgb.__version__} Booster.predict on public/models/challenger-*.txt; inputs float32 (apply Math.fround), null is NaN', 'machines': {}}
+
+
+def bucket(c):
+    k, t = c[0], c[3]
+    if k == 0: return 0
+    if k == 1: return 1
+    if k == 2: return 2 if t < 60 else 3 if t < 150 else 4 if t < 270 else 5
+    return 9
+
+
+for m in ('odte', 'weekly'):
+    bst = lgb.Booster(model_file=os.path.join(root, f'public/models/challenger-{m}.txt'))
+    d = df[df.sleeve == m]
+    X = d[[f'c{i}' for i in range(meta['inputs'])]].values.astype(np.float32)
+    pick = rng.choice(len(X), size=min(200, len(X)), replace=False)
+    rows = [X[i].astype(np.float64) for i in pick]
+    n = meta['inputs']
+    rows += [np.full(n, np.nan), np.zeros(n), np.full(n, 1e30), np.full(n, -1e30)]
+    X2 = np.vstack(rows)
+    raw = bst.predict(X2)
+    cal = []
+    for x, r in zip(X2, raw):
+        maps = meta['machines'][m]['calibration']
+        mp = maps.get(str(bucket(x)), maps['all'])
+        cal.append(float(np.interp(r, mp['x'], mp['y'])))
+    enc = lambda v: None if np.isnan(v) else float(str(np.float32(v)))
+    out['machines'][m] = {'vectors': [[enc(v) for v in r] for r in X2], 'raw': [float(v) for v in raw], 'cal': cal}
+path = os.path.join(root, 'scripts/fixtures/challenger-parity.json')
+json.dump(out, open(path, 'w'), separators=(',', ':'))
+print(path, {m: len(v['raw']) for m, v in out['machines'].items()})
