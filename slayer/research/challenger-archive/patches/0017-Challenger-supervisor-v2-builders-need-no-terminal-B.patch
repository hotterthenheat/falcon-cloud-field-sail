diff --git a/slayer/research/challenger/stop_pipeline.py b/slayer/research/challenger/stop_pipeline.py
new file mode 100644
index 0000000..857b543
--- /dev/null
+++ b/slayer/research/challenger/stop_pipeline.py
@@ -0,0 +1,28 @@
+"""Stop the challenger's own background processes (supervisors, fetchers, builders), never anything else: matched by
+their command line naming research/challenger/ scripts, this process and its parents excluded.
+
+  python3 research/challenger/stop_pipeline.py [--dry]
+"""
+import os, signal, subprocess, sys
+
+me = {os.getpid(), os.getppid()}
+out = subprocess.run(['ps', '-eo', 'pid,ppid,args'], capture_output=True, text=True).stdout.splitlines()[1:]
+keys = ('research/challenger/build.ts', 'research/challenger/fetch.ts', 'research/challenger/keepgoing.sh', 'research/challenger/keepgoing2.sh',
+        'research/challenger/extra_builder.sh', 'research/challenger/extra_fetch.sh')
+hit = []
+for line in out:
+    pid, ppid, args = line.strip().split(None, 2)
+    pid = int(pid)
+    if pid in me or 'stop_pipeline' in args:
+        continue
+    if any(k in args for k in keys) and not args.startswith('/bin/bash -c') and 'snapshot' not in args:
+        hit.append((pid, args[:110]))
+for pid, a in hit:
+    print(pid, a)
+if '--dry' not in sys.argv:
+    for pid, _ in hit:
+        try:
+            os.kill(pid, signal.SIGTERM)
+        except ProcessLookupError:
+            pass
+    print(f'stopped {len(hit)}')
