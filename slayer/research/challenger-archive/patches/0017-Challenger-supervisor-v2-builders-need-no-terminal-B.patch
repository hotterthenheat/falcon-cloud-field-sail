@@ -0,0 +1,30 @@
+#!/bin/bash
+# The challenger's data supervisor (v2): rounds of ~105 minutes, each resumable.
+#   - fetch, newest first (2026-10 back to 2025-01), one request in flight; and once a round, Book C's 15:20:15 boards
+#     for every fetched day still missing one (one request in flight);
+#   - five row builders that need no terminal (CHAL_NET unset): two newest first, one oldest first, one on 2022, one
+#     on 2024 (the day locks keep them apart);
+#   - then the ledger's 1-second settlement of every day built without the terminal (resettle.ts).
+#   setsid nohup bash research/challenger/keepgoing2.sh > research/challenger/data/keepgoing2.log 2>&1 &
+cd "$(dirname "$0")/../.." || exit 1
+echo $$ > research/challenger/data/keepgoing.pid
+export OMP_WAIT_POLICY=PASSIVE
+unset CHAL_NET
+D=research/challenger/data
+for round in $(seq 1 20); do
+  echo "round $round $(date -u +%FT%TZ)"
+  CHAL_CONC=1 npx tsx research/challenger/fetch.ts --from 2026-10-30 --to 2025-01-01 --minutes 100 >> $D/fetch.log 2>&1 &
+  f1=$!
+  CHAL_CONC=1 npx tsx research/challenger/fetch.ts --sweeps --minutes 100 >> $D/fetch-sweeps.log 2>&1 &
+  f2=$!
+  CHAL_BUILD_CONC=2 npx tsx research/challenger/build.ts --minutes 100 >> $D/build.log 2>&1 &
+  b1=$!
+  CHAL_BUILD_CONC=1 npx tsx research/challenger/build.ts --oldest --minutes 100 >> $D/build2.log 2>&1 &
+  b2=$!
+  CHAL_PREFIX=2022 CHAL_BUILD_CONC=1 npx tsx research/challenger/build.ts --oldest --minutes 100 >> $D/build3.log 2>&1 &
+  b3=$!
+  CHAL_PREFIX=2024 CHAL_BUILD_CONC=1 npx tsx research/challenger/build.ts --oldest --minutes 100 >> $D/build3.log 2>&1 &
+  b4=$!
+  wait $f1 $f2 $b1 $b2 $b3 $b4
+  timeout 1800 npx tsx research/challenger/resettle.ts >> $D/resettle.log 2>&1
+done
