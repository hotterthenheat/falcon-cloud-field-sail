+"""Export a candidate's calls on the development sessions for the ledger's 1-second settlement (settle_calls.ts), and
+compare the minute-path returns with the 1-second ones.
+
+  python -I research/challenger/export_calls.py K2b-overnight-SPXW-only data/k2b-calls.json
+  npx tsx research/challenger/settle_calls.ts data/k2b-calls.json data/k2b-settled.json
+  python -I research/challenger/export_calls.py --compare data/k2b-calls.json data/k2b-settled.json
+"""
+import datetime as dt, json, os, sys
+import numpy as np
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import common as C
+import books as B
+import candidates as K
+from zoneinfo import ZoneInfo
+
+NY = ZoneInfo('America/New_York')
+
+
+def mark_ms(day, mark, session):
+    d = dt.date.fromisoformat(day)
+    h, m = int(mark[:2]), int(mark[3:5])
+    if session == 'overnight' and h * 60 + m >= 20 * 60 + 15:
+        d = d - dt.timedelta(days=1)  # the calendar evening before (Sunday night for a Monday session)
+    t = dt.datetime(d.year, d.month, d.day, h, m, tzinfo=NY)
+    return int(t.timestamp() * 1000), t.date().isoformat()
+
+
+if sys.argv[1] == '--compare':
+    calls = json.load(open(sys.argv[2]))
+    got = {o['key'].split('|', 1)[1].rsplit('|', 1)[0] + '|' + str(o['mark']): o for o in json.load(open(sys.argv[3]))}
+    r_min, r_sec = [], []
+    for c in calls:
+        o = got.get(f"{c['contract']}|{c['sleeve']}|{c['mark']}")
+        oc = (o or {}).get('outcome') or {}
+        if oc.get('pnl') is None or not oc.get('fill'):
+            continue
+        r_min.append(c['ret_minute'])
+        r_sec.append(oc['pnl'] / (oc['fill']['ask'] * 100))
+    print(f'{len(r_sec)} calls settled: minute path {100 * np.mean(r_min):+.1f}%/call, 1-second exits {100 * np.mean(r_sec):+.1f}%/call, hit {100 * np.mean(np.array(r_sec) > 0):.0f}%')
+    sys.exit(0)
+
+name, out = sys.argv[1], sys.argv[2]
+S = B.Sessions(B.dev_days())
+idx, ex = K.REGISTRY[name](S, np.ones(len(S.df), bool))
+pnl = {'prun': S.pnl_prun, 'ride': S.pnl_ride, 'tp': S.pnl_tp}
+rows = []
+for i in idx:
+    r = S.df.loc[i]
+    ms, cday = mark_ms(r['day'], r['mark'], r['session'])
+    runner = ex[i] == 'ride' or (ex[i] == 'prun' and (r['bGate'] == 1 and r['aGate'] == 0 or (np.isfinite(r['prun']) and r['prun'] >= 0.5)))
+    rows.append({'day': r['day'], 'callDay': cday, 'ticker': r['ticker'], 'contract': r['contract'], 'strike': float(r['strike']), 'right': r['right'], 'expiry': r['expiry'],
+                 'sleeve': r['sleeve'], 'book': 'B' if (r['bGate'] == 1 and r['aGate'] == 0) else 'A', 'mark': ms, 'bid': float(r['bid']), 'ask': float(r['ask']), 'runner': bool(runner),
+                 'flatAt': ms + int(r['flatAt']) * 60_000, 'ret_minute': float(pnl[ex[i]][i] / (S.fill[i] * 100)) if S.fill[i] > 0 else None})
+json.dump(rows, open(out, 'w'), indent=1)
+print(f'{len(rows)} calls written to {out}')
diff --git a/slayer/research/challenger/holdout.py b/slayer/research/challenger/holdout.py
new file mode 100644
index 0000000..ac25477
--- /dev/null
+++ b/slayer/research/challenger/holdout.py
@@ -0,0 +1,88 @@
+"""Score frozen candidates on the development sessions (any number of times) or on the LOCKED holdout (once each).
+
+  python -I research/challenger/holdout.py --dev K1-always-ride K2-current+overnight-SPXW
+  python -I research/challenger/holdout.py --final K1-always-ride            (once; writes data/holdout/<name>.json)
+
+Each table: the candidate against the three current books (Hit score + Runner, the Hit score without the ride, the
+Late sweep) on the same sessions, same seats, same exits, return first, dollars beside; the paired differences; and
+the cut by holdout block / regime and by the session the call was made in.
+"""
+import argparse, json, os, sys
+import numpy as np
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import common as C
+import books as B
+import candidates as K
+
+
+def per_session(S, idx, exits):
+    out = {d: [] for d in S.days}
+    pnl = {'prun': S.pnl_prun, 'ride': S.pnl_ride, 'tp': S.pnl_tp}
+    for i in idx:
+        p = pnl[exits[i]][i]
+        if np.isfinite(p) and S.fill[i] > 0:
+            out[S.df.at[i, 'day']].append((p / (S.fill[i] * 100), p, i))
+    return out
+
+
+def evaluate(S, name, title, cut):
+    mask = np.ones(len(S.df), bool)
+    cur_idx, cur_ex = K.current(S, mask)
+    books = {
+        'Hit score + Runner (current A/B)': per_session(S, cur_idx, cur_ex),
+        'Hit score, no ride': per_session(S, cur_idx, {i: 'tp' for i in cur_idx}),
+        'Late sweep (Book C)': S.late_sweep(),
+    }
+    idx, ex = K.REGISTRY[name](S, mask)
+    books[f'{name}'] = per_session(S, idx, ex)
+    lines = [f'### {name}: {title}, {len(S.days)} sessions ({S.days[0]} .. {S.days[-1]})', '', B.table([B.summarize(v, k) for k, v in books.items()]), '']
+    mine = books[name]
+    res = {'name': name, 'title': title, 'sessions': S.days, 'rows': [B.summarize(v, k) for k, v in books.items()], 'paired': {}}
+    for k in list(books)[:3]:
+        pt, lo, hi = B.paired(mine, books[k])
+        res['paired'][k] = [pt.tolist(), lo.tolist(), hi.tolist()]
+        lines.append(f'- {name} minus {k}: return/call {100 * pt[0]:+.1f}% [{100 * lo[0]:+.1f}, {100 * hi[0]:+.1f}]; return/session {100 * pt[1]:+.1f}% [{100 * lo[1]:+.1f}, {100 * hi[1]:+.1f}]; $/session {pt[2]:+.0f} [{lo[2]:+.0f}, {hi[2]:+.0f}]')
+    parts = {k: B.split(v, cut) for k, v in books.items()}
+    for g in sorted(set(cut(d) for d in S.days)):
+        lines += ['', f'**{g}**', '', B.table([B.summarize(parts[k].get(g, {}), k) for k in books])]
+    sess = S.df['session'].values
+    for kind in ('overnight', 'pre', 'regular'):
+        rows = [B.summarize({d: [x for x in v if x[2] >= 0 and sess[x[2]] == kind] for d, v in per.items()}, k) for k, per in books.items() if not k.startswith('Late')]
+        lines += ['', f'**calls made in the {kind} session**', '', B.table(rows)]
+    return '\n'.join(lines), res
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('names', nargs='+')
+    ap.add_argument('--dev', action='store_true')
+    ap.add_argument('--final', action='store_true')
+    ap.add_argument('--again', action='store_true')
+    a = ap.parse_args()
+    if a.dev == a.final:
+        sys.exit('say --dev or --final')
+    if a.dev:
+        S = B.Sessions(B.dev_days())
+        for n in a.names:
+            print(evaluate(S, n, 'development sessions', B.regime)[0], '\n')
+        return
+    hold = B.holdout_days()
+    blocks = sorted(set(B.holdout_block(d) for d in hold))
+    if blocks != ['H-2022', 'H-2024', 'H-recent']:
+        sys.exit(f'the holdout is not fully built yet ({blocks}); a final look waits for every block')
+    S = B.Sessions(hold)
+    os.makedirs(os.path.join(C.DATA, 'holdout'), exist_ok=True)
+    for n in a.names:
+        f = os.path.join(C.DATA, 'holdout', f'{n}.json')
+        if os.path.exists(f) and not a.again:
+            print(f'{n}: already scored on the holdout once ({f}); not looking again')
+            continue
+        text, res = evaluate(S, n, 'LOCKED HOLDOUT', B.holdout_block)
+        res['looks'] = (json.load(open(f))['looks'] + 1) if os.path.exists(f) else 1
+        json.dump(res, open(f, 'w'), indent=1, default=float)
+        open(f.replace('.json', '.md'), 'w').write(text)
+        print(text, '\n')
+
+
+if __name__ == '__main__':
+    main()
