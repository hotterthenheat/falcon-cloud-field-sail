@@ -0,0 +1,58 @@
+"""Frozen candidates and the one-shot holdout evaluation.
+
+A candidate is a function of a Sessions object returning (called row labels, exit rule per call). Its spec is frozen
+in this file (and in LOG.md) before it is scored on the locked holdout; `holdout.py <name>` scores it once and
+writes data/holdout/<name>.json; a second run refuses unless --again (which is logged as a second look).
+"""
+import numpy as np
+import common as C
+
+OVERNIGHT_ROOTS_K2 = ('SPXW',)
+
+
+def current(S, days_mask):
+    """The live Books A/B: the Hit score at its line, the Runner score's ride rule."""
+    idx = S.calls(S.df['p1'].values.astype(float), C.P1_MIN, days_mask)
+    return idx, {i: 'prun' for i in idx}
+
+
+def k1_always_ride(S, days_mask):
+    """K1: the Hit score's own calls, Book A always riding the ratchet (Book B rides as live)."""
+    idx = S.calls(S.df['p1'].values.astype(float), C.P1_MIN, days_mask)
+    return idx, {i: 'ride' for i in idx}
+
+
+def overnight_rule(df, roots):
+    """The overnight rule: overnight session, these roots, |delta| 0.15-0.30, 2 h to 11 h 40 into the session, the side
+    the overnight move favours so far (gap vs the prior close > 0, signed by side); the strike nearest 0.225 delta."""
+    d = df
+    el = ((d['session'].values == 'overnight') & np.isin(d['ticker'].values, roots)
+          & (d['c14'].values >= 0.15) & (d['c14'].values <= 0.30)
+          & (d['c1'].values >= 120) & (d['c1'].values <= 700) & (d['c33'].values > 0))
+    return el, 1.0 - np.abs(d['c14'].values - 0.225)
+
+
+def k2_current_plus_overnight_spx(S, days_mask):
+    """K2: one book, one set of seats: the live Books A/B in the regular session (Hit score >= 0.7067, Runner ride) and
+    the overnight rule on SPXW (1.50x take-profit exit, Book A rules). An overnight call holds its root's seat."""
+    d = S.df
+    p1 = d['p1'].values.astype(float)
+    el, s_on = overnight_rule(d, OVERNIGHT_ROOTS_K2)
+    reg = d['session'].values == 'regular'
+    score = np.where(el, s_on, np.where(reg & (p1 + 1e-12 >= C.P1_MIN), p1, np.nan))
+    idx = S.calls(score, 0.0, days_mask)
+    return idx, {i: ('tp' if d.at[i, 'session'] == 'overnight' else 'prun') for i in idx}
+
+
+def k2b_overnight_spx_only(S, days_mask):
+    """K2's overnight calls alone (what the overnight rule adds, as its own book)."""
+    el, s_on = overnight_rule(S.df, OVERNIGHT_ROOTS_K2)
+    idx = S.calls(np.where(el, s_on, np.nan), 0.0, days_mask)
+    return idx, {i: 'tp' for i in idx}
+
+
+REGISTRY = {
+    'K1-always-ride': k1_always_ride,
+    'K2-current+overnight-SPXW': k2_current_plus_overnight_spx,
+    'K2b-overnight-SPXW-only': k2b_overnight_spx_only,
+}
