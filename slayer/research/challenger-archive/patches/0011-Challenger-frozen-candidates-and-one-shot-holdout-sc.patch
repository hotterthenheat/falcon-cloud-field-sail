+/*
+  Settle a list of simulated calls with the ledger's own settlement (the one-minute path from the cache, the
+  1-second quotes of every stop/target minute from the terminal, cached): the same exits the live record uses.
+
+    npx tsx research/challenger/settle_calls.ts in.json out.json
+  in.json: [{ day, ticker, contract, strike, right, expiry, sleeve, book, mark (epoch ms), bid, ask, runner, flatAt }]
+*/
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const [inFile, outFile] = process.argv.slice(2);
+const calls = JSON.parse(fs.readFileSync(inFile, 'utf8')) as Record<string, unknown>[];
+const { localTheta } = await import('./localHost');
+const { setCompassHost } = await import('../../src/data/compassHost');
+const ledger = await import('../../src/data/compassLedger');
+const root = path.join(path.dirname(fileURLToPath(import.meta.url)), '..', '..');
+const byDay = new Map<string, Record<string, unknown>[]>();
+for (const c of calls) {
+  const l = byDay.get(String(c.day)) ?? [];
+  l.push(c);
+  byDay.set(String(c.day), l);
+}
+const out: unknown[] = [];
+for (const [day, list] of byDay) {
+  const host = localTheta(day, { net: true });
+  setCompassHost({ server: true, theta: host.theta, asset: async p => { const b = fs.readFileSync(path.join(root, 'public', p.replace(/^\/+/, ''))); return b.buffer.slice(b.byteOffset, b.byteOffset + b.byteLength) as ArrayBuffer; }, econ: () => [] });
+  ledger.importSignals([]);
+  ledger.importWould(list.map((c, k) => ({
+    key: `${day}|${c.contract}|${c.sleeve}|${k}`, id: `${c.contract}|${c.sleeve}`, day: c.callDay ?? day, book: c.book, ticker: c.ticker, contract: c.contract,
+    right: c.right, strike: c.strike, expiry: c.expiry, sleeve: c.sleeve, firedAt: c.mark, quoteAt: c.mark, bid: c.bid, ask: c.ask, spot: null,
+    p1: null, prun: null, runner: c.runner, outcome: null, pathAt: 0, spark: [], how: 'late', mark: c.mark, flatAt: c.flatAt, would: true,
+  })));
+  const open = () => ledger.wouldSignals().filter(s => !s.outcome || (s.outcome.status !== 'closed' && s.outcome.status !== 'unavailable'));
+  for (let pass = 0; pass < 60 && open().length; pass++) {
+    await ledger.settleOpen(Date.now() + pass * 60_000);
+    if (open().length) await new Promise(res => setTimeout(res, 500));
+  }
+  for (const s of ledger.wouldSignals()) out.push({ key: s.key, contract: s.contract, sleeve: s.sleeve, mark: s.mark, outcome: s.outcome });
+  console.log(`${day}: ${list.length} calls settled`);
+}
+fs.writeFileSync(outFile, JSON.stringify(out, null, 1));
+process.exit(0);
