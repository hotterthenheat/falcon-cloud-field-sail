+"""The seat simulation against the engine: on every built session, the Hit score run through common.simulate must
+call exactly the Book A/B contracts the engine's own late path called (rows/<day>.calls.json)."""
+import os, sys
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import common as C
+
+ok = bad = 0
+for d in C.days_built():
+    df = C.load_day(d)
+    idx = C.simulate(df, df['p1'].values, C.P1_MIN)
+    mine = sorted((df.at[i, 'contract'], df.at[i, 'sleeve'], df.at[i, 'mark']) for i in idx)
+    eng = []
+    for c in C.engine_calls(d):
+        if c['book'] == 'C':
+            continue
+        import datetime as dt
+        t = dt.datetime.fromtimestamp(c['mark'] / 1000, dt.timezone(dt.timedelta(hours=-4 if d < '2026-11-01' and d > '2026-03-08' else -5)))
+        eng.append((c['contract'], c['sleeve'], t.strftime('%H:%M')))
+    eng.sort()
+    same = mine == eng
+    ok += same
+    bad += not same
+    if not same:
+        print(d, 'MISMATCH', 'sim', mine, 'engine', eng)
+print(f'seat simulation matches the engine on {ok} of {ok + bad} sessions')
