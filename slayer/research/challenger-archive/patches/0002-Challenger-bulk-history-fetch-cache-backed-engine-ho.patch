@@ -0,0 +1,206 @@
+"""Challenger walk-forward: train, calibrate, choose the line, call through the seats, on held-out sessions only.
+
+  python -I research/challenger/train.py [--block 10] [--embargo 5] [--min-train 30] [--tag v1] [--final]
+
+Protocol (fixed before looking at any test session):
+  - Two machines: the same-day sleeve (0DTE) and the weekly sleeve (1-7 DTE), one LightGBM binary classifier each,
+    on the challenger inputs (c0..c59, src/data/challengerFeatures.ts), label = the 1.50x take-profit reached
+    before the stop under Book A's non-runner rules (the books' own exit, one-minute NBBO).
+  - Walk-forward by session: the held-out sessions come in consecutive blocks (`--block` sessions); a block's
+    models see only sessions that end `--embargo` sessions before it starts (purge: every label closes inside its
+    own session, so no training label overlaps a test session; the embargo keeps the slow inputs, e.g. the 15-session
+    HAR and the prior session, from straddling the boundary).
+  - Hyper-parameters fixed a priori (PARAMS below), never tuned on a test block.
+  - Inside each fold's training sessions, the last 25% (by date) are its calibration sessions: the trees are fit on
+    the first 75%; an isotonic map per time-of-day bucket is fit on the calibration sessions' raw scores; the line
+    (one number for both machines) is the one on a fixed grid that maximises the expected P&L per session of the
+    calls the seats make on the calibration sessions (no fees). Then the test block is scored, calibrated and called.
+  - The current book on the same sessions: the Hit score through the same seats at its own line (0.7067), with the
+    Runner score's ride rule; the Late sweep from the engine's own record. Exits identical (call_pnl).
+"""
+import argparse, json, os, sys, time
+import numpy as np
+import pandas as pd
+import lightgbm as lgb
+from sklearn.isotonic import IsotonicRegression
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import common as C
+
+PARAMS = dict(objective='binary', learning_rate=0.03, num_leaves=31, min_data_in_leaf=400, feature_fraction=0.8,
+              bagging_fraction=0.7, bagging_freq=1, lambda_l2=5.0, max_bin=255, verbose=-1, num_threads=4, seed=20261031,
+              deterministic=True, force_row_wise=True)
+ROUNDS = 400
+LINES = np.round(np.arange(0.30, 0.92, 0.02), 2)
+FEATS = [f'c{i}' for i in range(60)]
+
+
+def bucket(df):
+    """Time-of-day buckets the calibration is fit in: overnight, pre-market, and four regular-session windows."""
+    k = df['c0'].values
+    t = df['c3'].values
+    b = np.full(len(df), 9)
+    b[k == 0] = 0
+    b[k == 1] = 1
+    reg = k == 2
+    b[reg & (t < 60)] = 2
+    b[reg & (t >= 60) & (t < 150)] = 3
+    b[reg & (t >= 150) & (t < 270)] = 4
+    b[reg & (t >= 270)] = 5
+    return b
+
+
+def label(df):
+    return df['whyA'].str.startswith('Take profit').astype(int).values
+
+
+def fit(train):
+    ds = lgb.Dataset(train[FEATS].values.astype(np.float32), label=label(train), feature_name=FEATS, free_raw_data=True)
+    return lgb.train(PARAMS, ds, num_boost_round=ROUNDS)
+
+
+class Calib:
+    def __init__(self):
+        self.maps = {}
+
+    def fit(self, raw, y, b):
+        glob = IsotonicRegression(out_of_bounds='clip', y_min=0, y_max=1).fit(raw, y)
+        self.maps['all'] = glob
+        for k in np.unique(b):
+            m = b == k
+            if m.sum() >= 2000 and y[m].sum() >= 100:
+                self.maps[int(k)] = IsotonicRegression(out_of_bounds='clip', y_min=0, y_max=1).fit(raw[m], y[m])
+        return self
+
+    def __call__(self, raw, b):
+        out = self.maps['all'].predict(raw)
+        for k, m in self.maps.items():
+            if k == 'all':
+                continue
+            sel = b == k
+            if sel.any():
+                out[sel] = m.predict(raw[sel])
+        return out
+
+    def dump(self):
+        def one(m):
+            return {'x': [float(v) for v in m.X_thresholds_], 'y': [float(v) for v in m.y_thresholds_]}
+        return {str(k): one(m) for k, m in self.maps.items()}
+
+
+def machine_scores(df, models, calibs):
+    """Each row scored by its own sleeve's machine, raw and calibrated."""
+    raw = np.full(len(df), np.nan)
+    cal = np.full(len(df), np.nan)
+    b = bucket(df)
+    for sleeve in ('odte', 'weekly'):
+        m = (df['sleeve'] == sleeve).values
+        if not m.any() or sleeve not in models:
+            continue
+        r = models[sleeve].predict(df.loc[m, FEATS].values.astype(np.float32))
+        raw[m] = r
+        cal[m] = calibs[sleeve](r, b[m])
+    return raw, cal
+
+
+def per_day(df, idx, pnl):
+    out = {d: [] for d in df['day'].unique()}
+    for i in idx:
+        out[df.at[i, 'day']].append(pnl[i])
+    return out
+
+
+def choose_line(df, cal, pnl):
+    best = (-np.inf, None, 0)
+    days = df['day'].nunique()
+    for line in LINES:
+        idx = C.simulate(df, cal, line)
+        if len(idx) < max(10, days // 2):
+            continue
+        per_session = sum(pnl[i] for i in idx) / days
+        if per_session > best[0]:
+            best = (per_session, float(line), len(idx))
+    return best
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--block', type=int, default=10)
+    ap.add_argument('--embargo', type=int, default=5)
+    ap.add_argument('--min-train', type=int, default=30)
+    ap.add_argument('--tag', default='v1')
+    ap.add_argument('--final', action='store_true')
+    a = ap.parse_args()
+    days = C.days_built()
+    print(f'{len(days)} sessions built: {days[0]} .. {days[-1]}', flush=True)
+    t0 = time.time()
+    df = C.load(days)
+    df = df[df['fill'].notna()].reset_index(drop=True)
+    pnl, ride = C.call_pnl(df)
+    print(f'{len(df)} rows with a fill, {time.time() - t0:.0f} s', flush=True)
+    out_dir = os.path.join(C.DATA, 'wf', a.tag)
+    os.makedirs(out_dir, exist_ok=True)
+    folds = []
+    test_days = days[a.min_train + a.embargo:]
+    blocks = [test_days[i:i + a.block] for i in range(0, len(test_days), a.block)]
+    held = []
+    for bi, block in enumerate(blocks):
+        first = days.index(block[0])
+        train_days = days[:max(0, first - a.embargo)]
+        n_cal = max(5, len(train_days) // 4)
+        fit_days, cal_days = train_days[:-n_cal], train_days[-n_cal:]
+        tr = df[df['day'].isin(fit_days)]
+        ca = df[df['day'].isin(cal_days)]
+        te = df[df['day'].isin(block)]
+        models, calibs = {}, {}
+        for sleeve in ('odte', 'weekly'):
+            trs = tr[tr['sleeve'] == sleeve]
+            cas = ca[ca['sleeve'] == sleeve]
+            if len(trs) < 5000 or len(cas) < 2000:
+                continue
+            models[sleeve] = fit(trs)
+            raw = models[sleeve].predict(cas[FEATS].values.astype(np.float32))
+            calibs[sleeve] = Calib().fit(raw, label(cas), bucket(cas))
+        _, ca_cal = machine_scores(ca, models, calibs)
+        ca = ca.copy()
+        gain, line, n = choose_line(ca, ca_cal, pnl[ca.index.values] if False else C.call_pnl(ca)[0])
+        _, te_cal = machine_scores(te, models, calibs)
+        te = te.copy()
+        te['chal'] = te_cal
+        held.append(te[['day', 'sleeve', 'contract', 'mark', 'p1', 'prun', 'chal', 'session']].assign(line=line))
+        folds.append({'block': block, 'train': [fit_days[0], fit_days[-1]], 'cal': [cal_days[0], cal_days[-1]], 'line': line, 'cal_gain_per_day': gain, 'cal_calls': n})
+        print(f'fold {bi}: test {block[0]}..{block[-1]} train {fit_days[0]}..{fit_days[-1]} cal {cal_days[0]}..{cal_days[-1]} line {line} ({n} calls, ${gain:.0f}/day on calibration) {time.time() - t0:.0f} s', flush=True)
+    if held:
+        h = pd.concat(held)
+        h.to_parquet(os.path.join(out_dir, 'heldout_scores.parquet'))
+        with open(os.path.join(out_dir, 'folds.json'), 'w') as f:
+            json.dump({'params': PARAMS, 'rounds': ROUNDS, 'lines': LINES.tolist(), 'block': a.block, 'embargo': a.embargo, 'min_train': a.min_train, 'folds': folds}, f, indent=1)
+    if a.final:
+        final(df, days, out_dir, a)
+
+
+def final(df, days, out_dir, a):
+    """The shadow models: fit on every session but the last 25% (calibration and the line on those)."""
+    n_cal = max(5, len(days) // 4)
+    fit_days, cal_days = days[:-n_cal], days[-n_cal:]
+    tr = df[df['day'].isin(fit_days)]
+    ca = df[df['day'].isin(cal_days)].copy()
+    models, calibs, meta = {}, {}, {}
+    for sleeve in ('odte', 'weekly'):
+        models[sleeve] = fit(tr[tr['sleeve'] == sleeve])
+        cas = ca[ca['sleeve'] == sleeve]
+        raw = models[sleeve].predict(cas[FEATS].values.astype(np.float32))
+        calibs[sleeve] = Calib().fit(raw, label(cas), bucket(cas))
+        models[sleeve].save_model(os.path.join(out_dir, f'challenger-{sleeve}.txt'))
+        meta[sleeve] = {'trees': models[sleeve].num_trees(), 'calibration': calibs[sleeve].dump()}
+    _, ca_cal = machine_scores(ca, models, calibs)
+    gain, line, n = choose_line(ca, ca_cal, C.call_pnl(ca)[0])
+    doc = {'format': 'compass-challenger/1', 'inputs': len(FEATS), 'line': line, 'fit': [fit_days[0], fit_days[-1]], 'calibration_days': [cal_days[0], cal_days[-1]],
+           'buckets': 'c0 0 overnight, 1 pre-market; regular c3 <60, 60-150, 150-270, >=270', 'machines': meta, 'params': PARAMS, 'rounds': ROUNDS}
+    with open(os.path.join(out_dir, 'challenger-meta.json'), 'w') as f:
+        json.dump(doc, f, separators=(',', ':'))
+    print(f'final: fit {fit_days[0]}..{fit_days[-1]}, line {line} ({n} calls, ${gain:.0f}/day on calibration)')
+
+
+if __name__ == '__main__':
+    main()
