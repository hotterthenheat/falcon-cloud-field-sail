+++ b/slayer/research/challenger/common.py
@@ -0,0 +1,150 @@
+"""Challenger research: loading the rows (build.ts) and the books' seat rules, ported from compassModel.scoreRows
+(late path) so any score column can be run through the same seats: five Book A/B seats a session, one call a root,
+one call a contract, a pool per scoring pass (one name and sleeve at one mark), the drive rule (|return from the open|
+>= 0.35% calls only the drive's side), a flat root with both sides clearing calls neither, drive candidates first
+then the highest score. Book C is the engine's own (rows/<day>.calls.json)."""
+import glob, json, os, gzip
+import numpy as np
+import pandas as pd
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+DATA = os.environ.get('CHAL_DATA', os.path.join(HERE, 'data'))
+P1_MIN = 0.7067
+DRIVE = 0.0035
+SEAT_CAP = 5
+
+C_NAMES = None
+
+
+def days_built():
+    return sorted(os.path.basename(f)[:10] for f in glob.glob(os.path.join(DATA, 'rows', '*.calls.json')))
+
+
+def load_day(day, cache=True):
+    pq = os.path.join(DATA, 'rows', f'{day}.parquet')
+    src = os.path.join(DATA, 'rows', f'{day}.csv.gz')
+    if cache and os.path.exists(pq) and os.path.getmtime(pq) >= os.path.getmtime(src):
+        return pd.read_parquet(pq)
+    df = pd.read_csv(src, low_memory=False)
+    for c in ('whyA', 'whyR'):
+        df[c] = df[c].fillna('').astype(str).str.strip('"')
+    df['day'] = df['day'].astype(str)
+    if cache:
+        df.to_parquet(pq)
+    return df
+
+
+def load(days):
+    return pd.concat([load_day(d) for d in days], ignore_index=True)
+
+
+def engine_calls(day):
+    with open(os.path.join(DATA, 'rows', f'{day}.calls.json')) as f:
+        return json.load(f)['calls']
+
+
+def call_pnl(df, runner_rule='prun'):
+    """The P&L of each row as a call under the books' exits: Book B rides the ratchet; Book A rides it when the
+    Runner score cleared 0.50, else takes 1.50x. `runner_rule` 'none' never rides Book A, 'all' always does."""
+    b = df['bGate'].values.astype(bool) & ~df['aGate'].values.astype(bool)
+    if runner_rule == 'prun':
+        ride = df['prun'].fillna(-1).values >= 0.5
+    elif runner_rule == 'all':
+        ride = np.ones(len(df), bool)
+    elif runner_rule == 'none':
+        ride = np.zeros(len(df), bool)
+    else:
+        ride = np.asarray(runner_rule, bool)
+    ride = ride | b
+    return np.where(ride, df['pnlR'].values, df['pnlA'].values), ride
+
+
+def simulate(df, score, line, eligible=None):
+    """Run the score through the seats, one session at a time. `score` is an array aligned with df (NaN: not scored),
+    `line` a scalar or an array (a per-row line). Returns the index of the rows called, in call order."""
+    score = np.asarray(score, float)
+    line = np.broadcast_to(np.asarray(line, float), score.shape)
+    ok = np.isfinite(score) & (score + 1e-12 >= line) & (df['burns'].values == 0)
+    if eligible is not None:
+        ok &= np.asarray(eligible, bool)
+    called = []
+    sub = df.loc[ok, ['day', 'batch', 'order', 'ticker', 'right', 'contract', 'sleeve', 'aGate', 'bGate', 'retOpen']].copy()
+    sub['s'] = score[ok]
+    sub = sub.sort_values(['day', 'batch', 'order'], kind='stable')
+    for day, g in sub.groupby('day', sort=True):
+        roots = set()
+        ids = set()
+        for batch, b in g.groupby('batch', sort=True):
+            if len(roots) >= SEAT_CAP:
+                break
+            cands = []
+            for book_mask in (b['aGate'].values == 1, (b['aGate'].values == 0) & (b['bGate'].values == 1)):
+                pool = b[book_mask]
+                if not len(pool):
+                    continue
+                for ticker, lst in pool.groupby('ticker', sort=False):
+                    ret = lst['retOpen'].values
+                    ret = ret[np.isfinite(ret)]
+                    r0 = ret[0] if len(ret) else np.nan
+                    drive = np.isfinite(r0) and abs(r0) >= DRIVE
+                    if drive:
+                        side = lst[lst['right'] == ('C' if r0 > 0 else 'P')]
+                        if not len(side):
+                            continue
+                        best = side.index[np.argmax(side['s'].values)]
+                    else:
+                        if (lst['right'] == 'C').any() and (lst['right'] == 'P').any():
+                            continue
+                        best = lst.index[np.argmax(lst['s'].values)]
+                    cands.append((1 if drive else 0, b.loc[best, 's'], best))
+            cands.sort(key=lambda c: (-c[0], -c[1]))
+            any_drive = any(c[0] for c in cands)
+            for drive, s, idx in cands:
+                if any_drive and not drive:
+                    continue
+                t = sub.loc[idx, 'ticker']
+                cid = (sub.loc[idx, 'contract'], sub.loc[idx, 'sleeve'])
+                if len(roots) >= SEAT_CAP or t in roots or cid in ids:
+                    continue
+                roots.add(t)
+                ids.add(cid)
+                called.append(idx)
+    return called
+
+
+def block_boot(values_by_day, stat='mean_call', n=2000, seed=7):
+    """Session-block bootstrap: resample whole sessions with replacement. values_by_day: dict day -> array of call
+    P&Ls (an empty array for a session with no call). Returns (point, lo, hi) for the mean P&L per call or per day."""
+    rng = np.random.default_rng(seed)
+    days = sorted(values_by_day)
+    arrs = [np.asarray(values_by_day[d], float) for d in days]
+    def f(sel):
+        if stat == 'mean_call':
+            tot = sum(arrs[i].sum() for i in sel)
+            n_ = sum(len(arrs[i]) for i in sel)
+            return tot / n_ if n_ else np.nan
+        return sum(arrs[i].sum() for i in sel) / len(sel)
+    pt = f(range(len(days)))
+    bs = [f(rng.integers(0, len(days), len(days))) for _ in range(n)]
+    lo, hi = np.nanpercentile(bs, [2.5, 97.5])
+    return pt, lo, hi
+
+
+def paired_boot(a_by_day, b_by_day, stat='mean_call', n=2000, seed=11):
+    """The difference a - b on the same resampled sessions (both books, identical held-out days)."""
+    rng = np.random.default_rng(seed)
+    days = sorted(set(a_by_day) | set(b_by_day))
+    A = [np.asarray(a_by_day.get(d, []), float) for d in days]
+    B = [np.asarray(b_by_day.get(d, []), float) for d in days]
+    def f(arrs, sel):
+        if stat == 'mean_call':
+            n_ = sum(len(arrs[i]) for i in sel)
+            return sum(arrs[i].sum() for i in sel) / n_ if n_ else np.nan
+        return sum(arrs[i].sum() for i in sel) / len(sel)
+    pt = f(A, range(len(days))) - f(B, range(len(days)))
+    bs = []
+    for _ in range(n):
+        sel = rng.integers(0, len(days), len(days))
+        bs.append(f(A, sel) - f(B, sel))
+    lo, hi = np.nanpercentile(bs, [2.5, 97.5])
+    return pt, lo, hi
