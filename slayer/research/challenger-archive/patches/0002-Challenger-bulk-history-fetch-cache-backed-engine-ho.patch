+"""Self-time hotspots of the largest .cpuprofile in a folder (the builder's profile)."""
+import json, glob, collections, os, sys
+f = sorted(glob.glob(os.path.join(sys.argv[1], '*.cpuprofile')), key=os.path.getsize)[-1]
+p = json.load(open(f))
+nodes = {n['id']: n for n in p['nodes']}
+self_t = collections.Counter()
+for s, d in zip(p['samples'], p['timeDeltas']):
+    self_t[s] += d
+agg = collections.Counter()
+for nid, t in self_t.items():
+    cf = nodes[nid]['callFrame']
+    agg[(cf['functionName'], os.path.basename(cf['url']), cf['lineNumber'])] += t
+tot = sum(agg.values())
+print(f'total {tot / 1e6:.0f} s')
+for k, v in agg.most_common(30):
+    print(f'{v / tot * 100:5.1f}% {k}')
