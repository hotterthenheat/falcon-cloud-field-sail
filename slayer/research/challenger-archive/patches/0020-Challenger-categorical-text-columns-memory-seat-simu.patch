-        'cid': (df['contract'] + '|' + df['sleeve']).values[order],
+        'ticker': np.asarray(df['ticker'].astype(str))[order],
+        'call': (np.asarray(df['right'].astype(str))[order] == 'C'),
+        'cid': (df['contract'].astype(str) + '|' + df['sleeve'].astype(str)).values[order],
         'a': df['aGate'].values[order] == 1,
