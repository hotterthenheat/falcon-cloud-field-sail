diff --git a/slayer/research/challenger/holdout.py b/slayer/research/challenger/holdout.py
index 0e0adec..a922432 100644
--- a/slayer/research/challenger/holdout.py
+++ b/slayer/research/challenger/holdout.py
@@ -45,7 +45,7 @@ def evaluate(S, name, title, cut):
     parts = {k: B.split(v, cut) for k, v in books.items()}
     for g in sorted(set(cut(d) for d in S.days)):
         lines += ['', f'**{g}**', '', B.table([B.summarize(parts[k].get(g, {}), k) for k in books])]
