diff --git a/slayer/research/challenger/candidates.py b/slayer/research/challenger/candidates.py
index 50eda66..8e9e771 100644
--- a/slayer/research/challenger/candidates.py
+++ b/slayer/research/challenger/candidates.py
@@ -26,7 +26,7 @@ def overnight_rule(df, roots):
     """The overnight rule: overnight session, these roots, |delta| 0.15-0.30, 2 h to 11 h 40 into the session, the side
     the overnight move favours so far (gap vs the prior close > 0, signed by side); the strike nearest 0.225 delta."""
     d = df
-    el = ((d['session'].values == 'overnight') & np.isin(d['ticker'].values, roots)
+    el = ((np.asarray(d['session'].astype(str)) == 'overnight') & np.isin(np.asarray(d['ticker'].astype(str)), roots)
           & (d['c14'].values >= 0.15) & (d['c14'].values <= 0.30)
           & (d['c1'].values >= 120) & (d['c1'].values <= 700) & (d['c33'].values > 0))
     return el, 1.0 - np.abs(d['c14'].values - 0.225)
@@ -38,7 +38,7 @@ def k2_current_plus_overnight_spx(S, days_mask):
     d = S.df
     p1 = d['p1'].values.astype(float)
     el, s_on = overnight_rule(d, OVERNIGHT_ROOTS_K2)
-    reg = d['session'].values == 'regular'
+    reg = np.asarray(d['session'].astype(str)) == 'regular'
     score = np.where(el, s_on, np.where(reg & (p1 + 1e-12 >= C.P1_MIN), p1, np.nan))
     idx = S.calls(score, 0.0, days_mask)
     return idx, {i: ('tp' if d.at[i, 'session'] == 'overnight' else 'prun') for i in idx}
@@ -59,7 +59,7 @@ def k4_overnight_spx_otm(S, days_mask):
     delta; the 1.50x take-profit exit (Book A non-runner rules), its own flat 09:20. One call a night at most (one
     root, one seat)."""
     d = S.df
-    el = ((d['session'].values == 'overnight') & (d['ticker'].values == 'SPXW')
+    el = ((np.asarray(d['session'].astype(str)) == 'overnight') & (np.asarray(d['ticker'].astype(str)) == 'SPXW')
           & (d['c14'].values >= 0.10) & (d['c14'].values <= 0.20)
           & (d['c1'].values >= 120) & (d['c1'].values <= 700) & (d['c33'].values < 0))
     idx = S.calls(np.where(el, 1.0 - np.abs(d['c14'].values - 0.15), np.nan), 0.0, days_mask)
diff --git a/slayer/research/challenger/common.py b/slayer/research/challenger/common.py
index 27cdb42..032c0a3 100644
--- a/slayer/research/challenger/common.py
+++ b/slayer/research/challenger/common.py
