diff --git a/slayer/research/challenger/holes.py b/slayer/research/challenger/holes.py
new file mode 100644
index 0000000..d58c16e
--- /dev/null
+++ b/slayer/research/challenger/holes.py
@@ -0,0 +1,26 @@
+"""Built days with holes: an engine call left unsettled, or no Book C sweep on a day with same-day roots. Prints them,
+and with --redo removes their built files so the builders do them again.
+
+  python -I research/challenger/holes.py [--redo]
+"""
+import glob, json, os, sys
+
+DATA = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'data', 'rows')
+bad = []
+for f in sorted(glob.glob(os.path.join(DATA, '*.calls.json'))):
+    doc = json.load(open(f))
+    calls = doc['calls']
+    open_ = [c for c in calls if not c.get('outcome') or c['outcome'].get('status') not in ('closed', 'unavailable')]
+    c_calls = [c for c in calls if c['book'] == 'C']
+    if open_ or not c_calls:
+        bad.append((doc['day'], len(open_), len(c_calls)))
+for d, o, c in bad:
+    print(f'{d}: {o} unsettled, {c} Book C calls')
+print(f'{len(bad)} days with holes')
+if '--redo' in sys.argv:
+    for d, _, _ in bad:
+        for ext in ('.calls.json', '.parquet', '.csv.gz', '.lock'):
+            p = os.path.join(DATA, d + ext)
+            if os.path.exists(p):
+                os.remove(p)
+    print('removed; the builders will do them again')
