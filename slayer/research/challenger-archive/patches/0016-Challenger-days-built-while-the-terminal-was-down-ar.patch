@@ -0,0 +1,42 @@
+/*
+  Settle again, by the ledger's own rules, the engine calls a built day left open (built without the terminal, or
+  while it restarted), and write them back into rows/<day>.calls.json.
+
+    npx tsx research/challenger/resettle.ts [day …]        (no day: every built day with an open call)
+*/
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { DATA } from './fetch';
+
+const OUT = path.join(DATA, 'rows');
+const root = path.join(path.dirname(fileURLToPath(import.meta.url)), '..', '..');
+const named = process.argv.slice(2).filter(a => /^\d{4}-\d{2}-\d{2}$/.test(a));
+const isOpen = (c: { outcome?: { status?: string } | null }) => !c.outcome || (c.outcome.status !== 'closed' && c.outcome.status !== 'unavailable');
+const days = named.length ? named : fs.readdirSync(OUT).filter(f => f.endsWith('.calls.json')).map(f => f.slice(0, 10)).filter(d => {
+  const doc = JSON.parse(fs.readFileSync(path.join(OUT, `${d}.calls.json`), 'utf8')) as { calls: { outcome?: { status?: string } | null }[] };
+  return doc.calls.some(isOpen);
+}).sort();
+const { localTheta } = await import('./localHost');
+const { setCompassHost } = await import('../../src/data/compassHost');
+const ledger = await import('../../src/data/compassLedger');
+for (const day of days) {
+  const file = path.join(OUT, `${day}.calls.json`);
+  const doc = JSON.parse(fs.readFileSync(file, 'utf8')) as { calls: (Record<string, unknown> & { key: string; outcome?: { status?: string } | null })[] };
+  const host = localTheta(day, { net: true });
+  setCompassHost({ server: true, theta: host.theta, asset: async p => { const b = fs.readFileSync(path.join(root, 'public', p.replace(/^\/+/, ''))); return b.buffer.slice(b.byteOffset, b.byteOffset + b.byteLength) as ArrayBuffer; }, econ: () => [] });
+  const { sessionCloseMinOn } = await import('../../src/core/calendar');
+  const close = sessionCloseMinOn(day);
+  ledger.setSessionClose(close < 16 * 60 ? close : null);
+  ledger.importSignals([]);
+  ledger.importWould(doc.calls.map(c => (isOpen(c) ? { ...c, outcome: null, pathAt: 0, spark: [] } : c)));
+  for (let pass = 0; pass < 60 && ledger.wouldSignals().some(isOpen); pass++) {
+    await ledger.settleOpen(Date.now() + pass * 60_000);
+    if (ledger.wouldSignals().some(isOpen)) await new Promise(res => setTimeout(res, 500));
+  }
+  const settled = new Map(ledger.wouldSignals().map(s => [s.key, s]));
+  doc.calls = doc.calls.map(c => (settled.get(c.key) as unknown as typeof c) ?? c);
+  fs.writeFileSync(file, JSON.stringify(doc, null, 1));
+  console.log(`${day}: ${doc.calls.filter(isOpen).length} still open of ${doc.calls.length}`);
+}
+process.exit(0);
