@@ -0,0 +1,65 @@
+/* The challenger's hard-stop exit (shadow only; the live books never read this): the fill and the flat as the books'
+   (compassOutcome settleSignal), the 1.50x take-profit, and the 0.5322 stop that never moves — no break-even at
+   1.25x, no ratchet, no reversal. Its 1-second minutes are the ones whose bid range crosses the stop or the target.
+   research/challenger/LOG.md: on the overnight SPX calls the break-even move stopped many calls at their own price
+   before they reached 1.50x. */
+
+import { STOP_KEEP } from './compassParams';
+import type { Outcome, PathQuote, SignalCore } from './compassOutcome';
+
+const FILL_WAIT_MS = 3 * 60_000;
+const TP = 1.5;
+const valid = (q: PathQuote) => q.ask > 0 && q.bid >= 0 && q.ask >= q.bid;
+
+/** Settle on the quotes printed after the call (minute quotes, plus any 1-second quotes inside them). */
+export function settleHard(sig: SignalCore, quotes: readonly PathQuote[], now: number): Outcome {
+  const rows = quotes.filter(q => Number.isFinite(q.t) && q.t > sig.firedAt).slice().sort((a, b) => a.t - b.t);
+  const base: Outcome = { status: 'waiting', fill: null, exit: null, peak: 0, stop: 0, last: null, ret: null, pnl: null, heldMin: null };
+  const due = Math.floor(sig.firedAt / 60_000) * 60_000 + 60_000;
+  const at = rows.findIndex(q => q.t >= due);
+  if (at < 0 || rows[at].t > sig.firedAt + FILL_WAIT_MS) return now > sig.firedAt + FILL_WAIT_MS ? { ...base, status: 'unavailable' } : base;
+  const fill = rows[at];
+  if (!valid(fill)) return { ...base, status: 'unavailable' };
+  const paid = fill.ask;
+  const stop = paid * STOP_KEEP;
+  const flat = sig.flatAt ?? Infinity;
+  const done = (q: PathQuote, px: number, why: string, peak: number): Outcome => ({
+    status: 'closed', fill: { at: fill.t, bid: fill.bid, ask: fill.ask }, exit: { at: q.t, px, why }, peak, stop, last: q,
+    ret: Number(((px / paid - 1) * 100).toFixed(1)), pnl: Number(((px - paid) * 100).toFixed(2)), heldMin: Math.max(0, Math.round((q.t - fill.t) / 60_000)),
+  });
+  let peak = 0;
+  let last = fill;
+  for (let i = at + 1; i < rows.length; i++) {
+    const q = rows[i];
+    if (!valid(q)) continue;
+    if (q.t >= flat) return done(q, q.bid, 'Flat', peak);
+    if (q.bid <= stop) return done(q, q.bid, 'Stop', peak);
+    if (q.bid >= paid * TP) return done(q, Number((paid * TP).toFixed(2)), 'Take profit 1.50×', peak);
+    peak = Math.max(peak, q.bid);
+    last = q;
+  }
+  if (now >= flat + 10 * 60_000) return done(last, last.bid, 'Last quote', peak);
+  return { status: 'open', fill: { at: fill.t, bid: fill.bid, ask: fill.ask }, exit: null, peak, stop, last, ret: null, pnl: null, heldMin: null };
+}
+
+/** The minutes whose 1-second quotes decide the hard exit: each minute (after the fill, up to the minute-path exit)
+    whose bid range crosses the stop or the 1.50x target. At most `max`, the exit's own minute first. */
+export function hardWindows(sig: SignalCore, quotes: readonly PathQuote[], max = 12): [number, number][] {
+  const minute = quotes.filter(q => q.t % 60_000 === 0);
+  const out = settleHard(sig, minute, Number.MAX_SAFE_INTEGER);
+  if (!out.fill) return [];
+  const paid = out.fill.ask;
+  const levels = [paid * STOP_KEEP, paid * TP];
+  const end = out.exit?.at ?? Infinity;
+  const rows = minute.filter(q => q.t > out.fill!.at && q.t <= end && valid(q)).sort((a, b) => a.t - b.t);
+  const found: [number, number][] = [];
+  let prev: PathQuote = { t: out.fill.at, bid: out.fill.bid, ask: out.fill.ask };
+  for (const q of rows) {
+    const lo = Math.min(prev.bid, q.bid);
+    const hi = Math.max(prev.bid, q.bid);
+    if (levels.some(L => L >= lo && L <= hi)) found.push([prev.t, q.t]);
+    prev = q;
+  }
+  if (found.length <= max) return found;
+  return [found[found.length - 1], ...found.slice(0, max - 1)];
+}
