diff --git a/slayer/research/challenger/candidates.py b/slayer/research/challenger/candidates.py
index 8e9e771..1ed000f 100644
--- a/slayer/research/challenger/candidates.py
+++ b/slayer/research/challenger/candidates.py
@@ -66,7 +66,23 @@ def k4_overnight_spx_otm(S, days_mask):
     return idx, {i: 'tp' for i in idx}
 
 
+def k5_overnight_spx_hard(S, days_mask):
+    """K5 (frozen 2026-10-31 ~17:40 UTC, after the first holdout was spent; chosen on development (271 sessions,
+    the first holdout's included) by the a-priori rule "the highest development win rate among family F2's
+    configurations with at least 40 development calls", overfit.py FAMILY=F2): SPXW only, the overnight session,
+    |delta| 0.10-0.20, 00:00-05:59 (225-584 minutes after 20:15), the side the overnight move so far favours, the
+    strike nearest 0.15 delta, the HARD-STOP exit (1.50x take-profit or the 0.5322 stop, no break-even move; flat
+    09:20). Scored on the second holdout (H2) once."""
+    d = S.df
+    el = ((np.asarray(d['session'].astype(str)) == 'overnight') & (np.asarray(d['ticker'].astype(str)) == 'SPXW')
+          & (d['c14'].values >= 0.10) & (d['c14'].values <= 0.20)
+          & (d['c1'].values >= 225) & (d['c1'].values <= 584) & (d['c33'].values > 0))
+    idx = S.calls(np.where(el, 1.0 - np.abs(d['c14'].values - 0.15), np.nan), 0.0, days_mask)
+    return idx, {i: 'hard' for i in idx}
+
+
 REGISTRY = {
+    'K5-overnight-SPXW-hard': k5_overnight_spx_hard,
     'K4-overnight-SPXW-otm': k4_overnight_spx_otm,
     'K1-always-ride': k1_always_ride,
     'K2-current+overnight-SPXW': k2_current_plus_overnight_spx,
