diff --git a/slayer/research/challenger/ml.py b/slayer/research/challenger/ml.py
new file mode 100644
index 0000000..a2e19da
--- /dev/null
+++ b/slayer/research/challenger/ml.py
@@ -0,0 +1,212 @@
+"""Challenger machines, walk-forward on the development sessions only (the locked holdout is never read here), or
+frozen and scored once on the holdout (--holdout).
+
+  python -I research/challenger/ml.py --name M1 [--exit ride] [--target ret] [--only overnight] [--block 4] [--embargo 1]
+  python -I research/challenger/ml.py --name M1 ... --holdout      (fit on every development session, score the holdout)
+
+Spec (fixed before any test session): one LightGBM per sleeve on c0..c59; target 'ret' = the row's return as a call
+under the chosen exit (exit / fill - 1, clipped to [-1, 3]), or 'tp' = the 1.50x before the stop; the last quarter of
+each fold's training sessions calibrates an isotonic map per time-of-day bucket (score -> realised return, or
+-> hit rate); the line is the grid value that maximises the calibration sessions' return per session through the
+seats (at least one call per two sessions). Seats, gates and exits as the live books.
+"""
+import argparse, json, os, sys, time
+os.environ.setdefault('OMP_WAIT_POLICY', 'PASSIVE')
+import numpy as np
+import pandas as pd
+import lightgbm as lgb
+from sklearn.isotonic import IsotonicRegression
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import common as C
+import books as B
+from train import PARAMS, ROUNDS, bucket
+
+FEATS = [f'c{i}' for i in range(60)]
+
+
+def target(S, idx_rows, a):
+    pnl = {'prun': S.pnl_prun, 'ride': S.pnl_ride, 'tp': S.pnl_tp}[a.exit][idx_rows]
+    if a.target == 'tp':
+        return np.array([str(w).startswith('Take profit') for w in S.df['whyA'].values[idx_rows]], int)
+    r = pnl / (S.fill[idx_rows] * 100)
+    return np.clip(np.nan_to_num(r, nan=0.0), -1, 3)
+
+
+def mask_rows(S, days, a):
+    m = S.df['day'].isin(days).values & np.isfinite(S.fill)
+    if a.only:
+        m &= (S.df['session'].values == a.only)
+    return m
+
+
+def fit_machine(S, rows, a):
+    X = S.df.loc[rows, FEATS].values.astype(np.float32)
+    y = target(S, np.flatnonzero(rows), a)
+    p = dict(PARAMS)
+    p['objective'] = 'binary' if a.target == 'tp' else 'regression'
+    return lgb.train(p, lgb.Dataset(X, label=y, free_raw_data=True), num_boost_round=ROUNDS)
+
+
+class Calib:
+    def fit(self, raw, y, b):
+        self.maps = {'all': IsotonicRegression(out_of_bounds='clip').fit(raw, y)}
+        for k in np.unique(b):
+            m = b == k
+            if m.sum() >= 1500:
+                self.maps[int(k)] = IsotonicRegression(out_of_bounds='clip').fit(raw[m], y[m])
+        return self
+
+    def __call__(self, raw, b):
+        out = self.maps['all'].predict(raw)
+        for k, mp in self.maps.items():
+            if k != 'all' and (b == k).any():
+                out[b == k] = mp.predict(raw[b == k])
+        return out
+
+    def dump(self):
+        return {str(k): {'x': [float(v) for v in m.X_thresholds_], 'y': [float(v) for v in m.y_thresholds_]} for k, m in self.maps.items()}
+
+
+def score_rows(S, rows, models, calibs, a):
+    """Calibrated score for the given rows (NaN elsewhere and where the sleeve has no machine)."""
+    out = np.full(len(S.df), np.nan)
+    b = bucket(S.df)
+    for sleeve in ('odte', 'weekly'):
+        m = rows & (S.df['sleeve'].values == sleeve)
+        if a.only:
+            m &= (S.df['session'].values == a.only)
+        if not m.any() or sleeve not in models:
+            continue
+        r = models[sleeve].predict(S.df.loc[m, FEATS].values.astype(np.float32))
+        out[m] = calibs[sleeve](r, b[m])
+    return out
+
+
+LINES_RET = np.array([-0.2, -0.1, -0.05, 0, 0.02, 0.05, 0.08, 0.1, 0.15, 0.2, 0.3, 0.4, 0.6])
+LINES_TP = np.round(np.arange(0.2, 0.9, 0.04), 2)
+
+
+def choose_line(S, sc, days, a):
+    lines = LINES_TP if a.target == 'tp' else LINES_RET
+    best = (-np.inf, None, 0)
+    for ln in lines:
+        idx = S.calls(sc, ln)
+        if len(idx) < max(5, len(days) // 2):
+            continue
+        per = S.per_session(idx, a.exit)
+        tot = sum(x[0] for v in per.values() for x in v) / len(days)
+        if tot > best[0]:
+            best = (tot, float(ln), len(idx))
+    return best
+
+
+def train_fold(S, fit_days, cal_days, a):
+    models, calibs = {}, {}
+    fm = mask_rows(S, fit_days, a)
+    cm = mask_rows(S, cal_days, a)
+    b = bucket(S.df)
+    for sleeve in ('odte', 'weekly'):
+        f_ = fm & (S.df['sleeve'].values == sleeve)
+        c_ = cm & (S.df['sleeve'].values == sleeve)
+        if f_.sum() < 3000 or c_.sum() < 1000:
+            continue
+        models[sleeve] = fit_machine(S, f_, a)
+        raw = models[sleeve].predict(S.df.loc[c_, FEATS].values.astype(np.float32))
+        calibs[sleeve] = Calib().fit(raw, target(S, np.flatnonzero(c_), a), b[c_])
+    cal_rows = S.df['day'].isin(cal_days).values
+    sc = score_rows(S, cal_rows, models, calibs, a)
+    gain, line, n = choose_line(S, sc, cal_days, a)
+    return models, calibs, line, gain, n
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--name', required=True)
+    ap.add_argument('--exit', default='ride', choices=['prun', 'ride', 'tp'])
+    ap.add_argument('--target', default='ret', choices=['ret', 'tp'])
+    ap.add_argument('--only', default='', help='a session kind to train and call in (overnight, pre, regular)')
+    ap.add_argument('--block', type=int, default=4)
+    ap.add_argument('--embargo', type=int, default=1)
+    ap.add_argument('--min-train', type=int, default=12)
+    ap.add_argument('--holdout', action='store_true')
+    a = ap.parse_args()
+    out = os.path.join(C.DATA, 'ml', a.name)
+    os.makedirs(out, exist_ok=True)
+    t0 = time.time()
+    dev = B.dev_days()
+    if not a.holdout:
+        S = B.Sessions(dev)
+        chal = np.full(len(S.df), np.nan)
+        folds = []
+        test = dev[a.min_train + a.embargo:]
+        for i in range(0, len(test), a.block):
+            block = test[i:i + a.block]
+            train_days = dev[:max(0, dev.index(block[0]) - a.embargo)]
+            n_cal = max(3, len(train_days) // 4)
+            fit_days, cal_days = train_days[:-n_cal], train_days[-n_cal:]
+            models, calibs, line, gain, n = train_fold(S, fit_days, cal_days, a)
+            if line is None:
+                print(f'block {block[0]}: no line cleared on calibration; no calls', flush=True)
+                continue
+            rows = S.df['day'].isin(block).values
+            sc = score_rows(S, rows, models, calibs, a)
+            sc[rows & ~(sc + 1e-12 >= line)] = np.nan
+            chal[rows] = sc[rows] - line  # >= 0 calls (one line per fold)
+            folds.append({'block': [block[0], block[-1]], 'line': line, 'cal_ret_per_session': gain, 'cal_calls': n})
