+        tested = sorted(set(d for f in folds for d in S.days if f['block'][0] <= d <= f['block'][1]))
+        np.save(os.path.join(out, 'chal.npy'), chal)
+        json.dump({'args': vars(a), 'folds': folds, 'tested': tested}, open(os.path.join(out, 'folds.json'), 'w'), indent=1)
+        report(S, chal, 0.0, tested, a, 'walk-forward on development sessions')
+    else:
+        S = B.Sessions(dev + B.holdout_days())
+        n_cal = max(3, len(dev) // 4)
+        models, calibs, line, gain, n = train_fold(S, dev[:-n_cal], dev[-n_cal:], a)
+        hold = B.holdout_days()
+        rows = S.df['day'].isin(hold).values
+        sc = score_rows(S, rows, models, calibs, a)
+        for sleeve, m in models.items():
