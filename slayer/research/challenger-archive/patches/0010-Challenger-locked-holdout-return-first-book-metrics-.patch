diff --git a/slayer/research/challenger/books.py b/slayer/research/challenger/books.py
new file mode 100644
index 0000000..c766411
--- /dev/null
+++ b/slayer/research/challenger/books.py
@@ -0,0 +1,138 @@
+"""Books on a set of sessions, through the same seats and exits, measured in return (exit / fill - 1) and dollars.
+
+  from books import Sessions, HOLDOUT, is_holdout
+"""
+import os, sys
+import numpy as np
+import pandas as pd
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import common as C
+
+
+def is_holdout(day):
+    return ('2026-10-05' <= day <= '2026-10-30') or day.startswith('2022-06') or day.startswith('2024-08')
+
+
+def holdout_block(day):
+    if day.startswith('2022-06'):
+        return 'H-2022'
+    if day.startswith('2024-08'):
+        return 'H-2024'
+    if '2026-10-05' <= day <= '2026-10-30':
+        return 'H-recent'
+    return None
+
+
+def regime(day):
+    if day < '2021':
+        return '2020 crash'
+    if day < '2023':
+        return '2022 bear'
+    if day < '2025':
+        return '2024'
+    if day < '2026':
+        return '2025'
+    return '2026'
+
+
+def dev_days():
+    return [d for d in C.days_built() if not is_holdout(d)]
+
+
+def holdout_days():
+    return [d for d in C.days_built() if is_holdout(d)]
+
+
+class Sessions:
+    """The rows of a set of sessions, with each row's P&L under the books' exits."""
+
+    def __init__(self, days):
+        self.days = list(days)
+        df = C.load(self.days).reset_index(drop=True)
+        self.df = df
+        self.fill = df['fill'].values.astype(float)
+        self.pnl_prun, _ = C.call_pnl(df, 'prun')
+        self.pnl_ride, _ = C.call_pnl(df, 'all')
+        self.pnl_tp, _ = C.call_pnl(df, 'none')
+        self.engine = {d: C.engine_calls(d) for d in self.days}
+
+    def calls(self, score, line, eligible=None):
+        return C.simulate(self.df, score, line, eligible)
+
+    def per_session(self, idx, exit='prun'):
+        pnl = {'prun': self.pnl_prun, 'ride': self.pnl_ride, 'tp': self.pnl_tp}[exit]
+        out = {d: [] for d in self.days}
+        for i in idx:
+            if np.isfinite(pnl[i]) and self.fill[i] > 0:
+                out[self.df.at[i, 'day']].append((pnl[i] / (self.fill[i] * 100), pnl[i], i))
+        return out
+
+    def late_sweep(self):
+        out = {d: [] for d in self.days}
+        for d, calls in self.engine.items():
+            for c in calls:
+                o = c.get('outcome') or {}
+                if c['book'] == 'C' and o.get('pnl') is not None and o.get('fill'):
+                    out[d].append((o['pnl'] / (o['fill']['ask'] * 100), o['pnl'], -1))
+        return out
+
+
+def summarize(per, name, n_boot=2000, seed=5):
+    """Return per call, $ per call, return-sum and $ per session, each with a session-block 95% interval."""
+    days = sorted(per)
+    R = [np.array([x[0] for x in per[d]], float) for d in days]
+    P = [np.array([x[1] for x in per[d]], float) for d in days]
+    n = sum(len(r) for r in R)
+    def stats(sel):
+        nr = sum(len(R[i]) for i in sel)
+        sr = sum(R[i].sum() for i in sel)
+        sp = sum(P[i].sum() for i in sel)
+        return (sr / nr if nr else np.nan, sp / nr if nr else np.nan, sr / len(sel), sp / len(sel))
+    pt = stats(range(len(days)))
+    rng = np.random.default_rng(seed)
+    bs = np.array([stats(rng.integers(0, len(days), len(days))) for _ in range(n_boot)])
+    lo = np.nanpercentile(bs, 2.5, axis=0)
+    hi = np.nanpercentile(bs, 97.5, axis=0)
+    flat = np.concatenate(R) if n else np.array([])
+    return {'book': name, 'sessions': len(days), 'calls': n, 'hit': float((flat > 0).mean()) if n else np.nan,
+            'ret': pt[0], 'ret_lo': lo[0], 'ret_hi': hi[0], 'usd': pt[1], 'usd_lo': lo[1], 'usd_hi': hi[1],
+            'ret_day': pt[2], 'ret_day_lo': lo[2], 'ret_day_hi': hi[2], 'usd_day': pt[3], 'usd_day_lo': lo[3], 'usd_day_hi': hi[3],
+            'worst_ret': float(flat.min()) if n else np.nan}
+
+
+def paired(a, b, n_boot=2000, seed=9):
+    """a - b on the same resampled sessions: return per call, return per session, $ per session."""
+    days = sorted(set(a) | set(b))
+    def st(per, sel):
+        r = [x[0] for i in sel for x in per.get(days[i], [])]
+        p = [x[1] for i in sel for x in per.get(days[i], [])]
+        return (np.mean(r) if r else np.nan, sum(r) / len(sel), sum(p) / len(sel))
+    pt = np.subtract(st(a, range(len(days))), st(b, range(len(days))))
+    rng = np.random.default_rng(seed)
+    bs = []
+    for _ in range(n_boot):
+        sel = rng.integers(0, len(days), len(days))
+        bs.append(np.subtract(st(a, sel), st(b, sel)))
+    bs = np.array(bs)
+    return pt, np.nanpercentile(bs, 2.5, axis=0), np.nanpercentile(bs, 97.5, axis=0)
+
+
+def table(rows):
+    out = ['| book | sessions | calls | hit | return/call [95%] | $/call [95%] | return/session [95%] | $/session [95%] |', '|---|---:|---:|---:|---:|---:|---:|---:|']
+    for r in rows:
+        if not r['calls']:
+            out.append(f"| {r['book']} | {r['sessions']} | 0 | | | | | |")
+            continue
+        out.append(f"| {r['book']} | {r['sessions']} | {r['calls']} | {100 * r['hit']:.0f}% | {100 * r['ret']:+.1f}% [{100 * r['ret_lo']:+.1f}, {100 * r['ret_hi']:+.1f}] | "
+                   f"{r['usd']:+.0f} [{r['usd_lo']:+.0f}, {r['usd_hi']:+.0f}] | {100 * r['ret_day']:+.1f}% [{100 * r['ret_day_lo']:+.1f}, {100 * r['ret_day_hi']:+.1f}] | "
+                   f"{r['usd_day']:+.0f} [{r['usd_day_lo']:+.0f}, {r['usd_day_hi']:+.0f}] |")
+    return '\n'.join(out)
+
+
+def split(per, key):
+    """The same calls cut by a session property (regime, holdout block) or a call property (session kind)."""
+    out = {}
+    for d, xs in per.items():
+        k = key(d)
+        out.setdefault(k, {})[d] = xs
+    return out
