+                  open(os.path.join(out, 'challenger-meta.json'), 'w'), separators=(',', ':'))
+        print(f'frozen: fit on {len(dev) - n_cal} development sessions, line {line} on the last {n_cal}')
+        report(S, sc - line, 0.0, hold, a, 'LOCKED HOLDOUT (scored once)')
