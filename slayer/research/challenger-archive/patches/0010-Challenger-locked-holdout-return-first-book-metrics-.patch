+
+def report(S, chal, line, days, a, title):
+    days = sorted(days)
+    sub = S.df['day'].isin(days).values
+    cur = S.calls(S.df['p1'].values.astype(float), C.P1_MIN, sub)
+    mine = S.calls(np.where(sub, chal, np.nan), line)
+    keep = lambda per: {d: per[d] for d in days}
+    books = {
+        'Hit score + Runner (current A/B)': keep(S.per_session(cur, 'prun')),
+        'Late sweep (Book C)': keep(S.late_sweep()),
+        f'Challenger {a.name} ({a.exit} exit{", " + a.only if a.only else ""})': keep(S.per_session(mine, a.exit)),
+    }
+    print(f'\n### {a.name}: {title}, {len(days)} sessions\n')
+    print(B.table([B.summarize(v, k) for k, v in books.items()]))
+    ch = list(books.values())[2]
+    for k in list(books)[:2]:
+        pt, lo, hi = B.paired(ch, books[k])
+        print(f'- challenger minus {k}: return/call {100 * pt[0]:+.1f}% [{100 * lo[0]:+.1f}, {100 * hi[0]:+.1f}], return/session {100 * pt[1]:+.1f}% [{100 * lo[1]:+.1f}, {100 * hi[1]:+.1f}], $/session {pt[2]:+.0f} [{lo[2]:+.0f}, {hi[2]:+.0f}]')
+    for label, key in (('regime', B.regime), ('holdout block', lambda d: B.holdout_block(d) or 'dev')):
+        parts = {k: B.split(v, key) for k, v in books.items()}
+        for g in sorted(next(iter(parts.values())).keys()):
+            print(f'\n{label} {g}:')
+            print(B.table([B.summarize(parts[k].get(g, {}), k) for k in books]))
+    # by the session the call was made in
+    sess = S.df['session'].values
+    for kind in ('overnight', 'pre', 'regular'):
+        rows = []
+        for k, per in books.items():
+            if k.startswith('Late'):
+                continue
+            rows.append(B.summarize({d: [x for x in v if x[2] >= 0 and sess[x[2]] == kind] for d, v in per.items()}, k))
+        print(f'\ncalls made in the {kind} session:')
+        print(B.table(rows))
