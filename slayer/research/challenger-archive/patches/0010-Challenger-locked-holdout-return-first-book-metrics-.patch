@@ -0,0 +1,39 @@
+"""Development-only exploration (never the locked holdout): rule candidates on top of the Hit score's own candidates,
+through the same seats and exits, in return and dollars. Every configuration printed here counts as a hypothesis.
+
+  python -I research/challenger/explore.py
+"""
+import os, sys
+import numpy as np
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import common as C
+import books as B
+
+S = B.Sessions(B.dev_days())
+df = S.df
+p1 = df['p1'].values.astype(float)
+delta = df['c14'].values
+cheap = df['c18'].values      # premium / expected move
+rvi = df['c26'].values        # realised / implied, 30 min
+gap = df['c33'].values        # gap vs prior close, signed by side
+shock = df['c49'].values      # SPY vol shock
+dte = df['dte'].values
+f = np.isfinite
+CONFIGS = [
+    ('current (Hit score, Runner ride)', p1, C.P1_MIN, None, 'prun'),
+    ('Hit score, always ride', p1, C.P1_MIN, None, 'ride'),
+    ('Hit score, |delta| 0.30-0.70', p1, C.P1_MIN, f(delta) & (delta >= 0.3) & (delta <= 0.7), 'prun'),
+    ('Hit score, premium >= 0.3 EM (no cheap)', p1, C.P1_MIN, f(cheap) & (cheap >= 0.3), 'prun'),
+    ('Hit score, realised/implied >= 0.35', p1, C.P1_MIN, f(rvi) & (rvi >= 0.35), 'prun'),
+    ('Hit score, gap in the call\'s direction', p1, C.P1_MIN, f(gap) & (gap > 0), 'prun'),
+    ('Hit score, SPY vol shock >= 1', p1, C.P1_MIN, f(shock) & (shock >= 1), 'prun'),
+    ('Hit score, 0DTE only', p1, C.P1_MIN, dte == 0, 'prun'),
+    ('Hit score, 1-7 DTE only', p1, C.P1_MIN, dte >= 1, 'prun'),
+]
+rows = [B.summarize(S.late_sweep(), 'Late sweep (Book C)')]
+for name, score, line, elig, ex in CONFIGS:
+    idx = S.calls(score, line, elig)
+    rows.append(B.summarize(S.per_session(idx, ex), name))
+print(f'Development sessions: {len(S.days)} ({S.days[0]} .. {S.days[-1]}), {len(df):,} rows\n')
+print(B.table(rows))
+print(f'\nconfigurations evaluated: {len(CONFIGS)}')
