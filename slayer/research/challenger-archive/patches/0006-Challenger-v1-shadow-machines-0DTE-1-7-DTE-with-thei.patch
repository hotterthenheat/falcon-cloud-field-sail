diff --git a/slayer/research/challenger/keepgoing.sh b/slayer/research/challenger/keepgoing.sh
new file mode 100644
index 0000000..440c203
--- /dev/null
+++ b/slayer/research/challenger/keepgoing.sh
@@ -0,0 +1,18 @@
+#!/bin/bash
+# Keeps the challenger's data landing between sessions of work: every ~110 minutes it (re)starts the bulk fetch
+# (newest first, every Compass root, two requests in flight) and two row builders (newest-first and oldest-first),
+# each time-boxed, each resumable. Stop it with: kill $(cat research/challenger/data/keepgoing.pid)
+#   setsid nohup bash research/challenger/keepgoing.sh > research/challenger/data/keepgoing.log 2>&1 &
+cd "$(dirname "$0")/../.." || exit 1
+echo $$ > research/challenger/data/keepgoing.pid
+export CHAL_NET=1 CHAL_CONC=2 OMP_WAIT_POLICY=PASSIVE
+for round in $(seq 1 12); do
+  echo "round $round $(date -u +%FT%TZ)"
+  npx tsx research/challenger/fetch.ts --from 2026-10-30 --to 2025-01-01 --minutes 105 >> research/challenger/data/fetch.log 2>&1 &
+  f=$!
+  CHAL_BUILD_CONC=2 npx tsx research/challenger/build.ts --minutes 105 >> research/challenger/data/build.log 2>&1 &
+  b1=$!
+  CHAL_BUILD_CONC=1 npx tsx research/challenger/build.ts --oldest --minutes 105 >> research/challenger/data/build2.log 2>&1 &
+  b2=$!
+  wait $f $b1 $b2
+done
